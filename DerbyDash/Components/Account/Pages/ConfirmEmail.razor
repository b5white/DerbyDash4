@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using DerbyDash.Components.Shared
@using static DerbyDash.Components.Shared.RegistrationProgress

@attribute [AllowAnonymous]

<PageTitle>Confirm email</PageTitle>

<RegistrationLayout Steps="@registrationSteps" 
                   CurrentStep="confirm-email"
                   SidebarTitle="Email Confirmation"
                   SidebarDescription="Almost there! Just one more step to complete your registration.">
    
    <h1>Confirm email</h1>
    <StatusMessage Message="@statusMessage" />

    @if (emailConfirmed)
    {
        <div class="alert alert-success">
            <p>Your email has been confirmed successfully!</p>
            <p>Next step: <a href="Account/Manage/RaceTeam?IsFromRegistration=true">Set up your Race Team</a> to start racing!</p>
        </div>
    }
    else
    {
        <p>There was a problem confirming your email. Please try again or contact support.</p>
    }

</RegistrationLayout>

@code {
    private string? statusMessage;
    private bool emailConfirmed = false;
    private List<RegistrationStep> registrationSteps = new();
    
    [Inject]
    UserManager<ApplicationUser> UserManager { get; set; } = default!;
    [Inject]
    SignInManager<ApplicationUser> SignInManager { get; set; } = default!;
    [Inject]
    IdentityRedirectManager RedirectManager { get; set; } = default!;
    
    protected override void OnInitialized()
    {
        base.OnInitialized();
        var stepsHelper = new RegistrationSteps { CurrentStep = "confirm-email" };
        registrationSteps = stepsHelper.GetRegistrationSteps();
    }


    [Inject]
    public CustomAuthStateProvider AuthStateProvider { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = $"Error loading user with ID {UserId}";
        }
        else
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            if (result.Succeeded)
            {
                emailConfirmed = true;
                statusMessage = "Thank you for confirming your email.";
                AuthStateProvider.NotifyUserLogin();
                if(RememberMe)
                    await SignInManager.SignInAsync(user, true);
            }
            else
            {
                statusMessage = "Error confirming your email.";
            }
        }
    }
}
