@page "/Account/Manage/RaceTeam"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using DerbyDash.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using DerbyDash.Data
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Manage team members</PageTitle>

<h3>Current race team</h3>
@if (raceTeam.Any()) {
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Racer Name</th>
                    <th>Races Completed</th>
                    <th>Last Raced</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Racer racer in raceTeam) {
                    <tr>
                        <td>@racer.Name</td>
                        <td>@racer.RaceCount</td>
                        <td>@(racer.LastRaced?.ToString("MMM d, yyyy") ?? "Never")</td>
                        <td>
                            <button class="btn btn-sm btn-primary" @onclick="() => SetActiveRacer(racer)">
                                <i class="fas fa-check-circle"></i> Set Active
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-info">
                    <td><strong>Team Total</strong></td>
                    <td><strong>@TeamRaceCount</strong></td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
} else {
    <div class="alert alert-info">
        Your race team is empty. Add racers to get started!
    </div>
}

<h3 class="mt-3">Add a racer</h3>

<StatusMessage Message="@message"/>
<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="add-racer" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText type="text" @bind-Value="Input.MemberName" id="Input.MemberName" class="form-control" autocomplete="off" aria-required="true" />
                <label for="Input.MemberName" class="form-label">Enter a racing name for your student</label>
                <ValidationMessage For="() => Input.MemberName" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Add racer</button>
        </EditForm>
    </div>
</div>


