@page "/Account/Manage/RaceTeam"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using DerbyDash.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using DerbyDash.Data
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Manage team members</PageTitle>

<h3>Current race team</h3>
@if (raceTeam.Any()) {
    @foreach (Racer fm in raceTeam) {
        <div class="row">
            <div class="col-xl-6">
                @fm.Name
            </div>
        </div>
    }
} else {
    <div class="row">
        <div class="col-xl-6">
            is empty
        </div>
    </div>
}

<h3 class="mt-3">Add a racer</h3>

<StatusMessage Message="@message"/>
<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="add-racer" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText type="text" @bind-Value="Input.MemberName" id="Input.MemberName" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter a racing name (not a real name, please)" />
                <label for="Input.MemberName" class="form-label">Race name</label>
                <ValidationMessage For="() => Input.MemberName" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Add racer</button>
        </EditForm>
    </div>
</div>


