@page "/Account/ProcessLogin"
@using Microsoft.Extensions.Logging
@using System.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server

@attribute [AllowAnonymous]

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<ProcessLogin> Logger

@inject IdentityRedirectManager RedirectManager
@inject NavigationManager NavManager

<PageTitle>Processing Login - TurboFlash</PageTitle>

<div class="text-center">
    <h1>Processing your login...</h1>
    <div class="spinner-border mt-3" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public bool RememberMe { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    @inject CustomAuthStateProvider AuthStateProvider
    @inject AuthenticationStateProvider AuthenticationStateProvider

    static string targetUrl = "";

    protected override async Task OnInitializedAsync() {
        if (string.IsNullOrEmpty(Email)) {
            targetUrl = "/";
        } else {
            try {
                var user = await UserManager.FindByEmailAsync(Email);
                if (user != null) {
                    targetUrl = string.IsNullOrEmpty(ReturnUrl) || ReturnUrl == "/" ? "/RaceSetsMenu" : ReturnUrl;
                    // Sign in the user directly without password verification
                    // (password was already verified in the Login page)
                    await SignInManager.SignInAsync(user, RememberMe);
                    AuthStateProvider.NotifyUserLogin();
                    Logger.LogInformation("User logged in: {Email}", Email);
                    
                    // Give a small delay to ensure auth state change propagates
                    await Task.Delay(200);
                    StateHasChanged();
                } else {
                    // User not found, redirect back to login
                    Logger.LogInformation("User is null: {Email}", Email);
                    targetUrl = "/Account/Login";
                }
            } catch (Exception ex) {
                Logger.LogError(ex, "Error during login processing for user: {Email}", Email);
                targetUrl = "/Account/Login";
            }
        }
        Logger.LogInformation("We made it. User logged in: {Email}. Redirecting to: {targeturl}", Email, targetUrl);
        // Use forceLoad to ensure authentication state is refreshed
        await InvokeAsync(() => NavManager.NavigateTo(targetUrl, forceLoad: true));
    }
}
