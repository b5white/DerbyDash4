@page "/Account/ProcessLogin"
@using Microsoft.AspNetCore.Identity
@using DerbyDash.Data
@using Microsoft.Extensions.Logging
@using System.Web

@attribute [AllowAnonymous]
@rendermode InteractiveServer

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<ProcessLogin> Logger
@inject NavigationManager NavigationManager

<PageTitle>Processing Login - Derby Dash</PageTitle>

<div class="text-center">
    <h1>Processing your login...</h1>
    <div class="spinner-border mt-3" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public bool RememberMe { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    @inject CustomAuthStateProvider AuthStateProvider 

    static string targetUrl = "";

    protected override async Task OnInitializedAsync() {
        if (!await IsLoggedIn()) {

            if (string.IsNullOrEmpty(Email)) {
                targetUrl = "/";
                return;
            }

            try {
                var user = await UserManager.FindByEmailAsync(Email);

                if (user != null) {
                    // Sign in the user directly without password verification
                    // (password was already verified in the Login page)
                    await SignInManager.SignInAsync(user, RememberMe);
                    Logger.LogInformation("User logged in: {Email}", Email);

                    targetUrl = string.IsNullOrEmpty(ReturnUrl) || ReturnUrl == "/" ? "/RaceSetsMenu" : ReturnUrl;
                } else {
                    // User not found, redirect back to login
                    targetUrl = "/";
                }
            } catch (Exception ex) {
                Logger.LogError(ex, "Error during login processing for user: {Email}", Email);
                targetUrl = "/";
            }
        }
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            // Check if targetUrl is not null or empty before navigating
            if (!string.IsNullOrEmpty(targetUrl)) {
                NavigationManager.NavigateTo(targetUrl, forceLoad: true);
            } else {
                Logger.LogWarning("Navigation aborted: targetUrl is null or empty.");
            }
        }
    }

    private async Task<bool> IsLoggedIn() {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.IsAuthenticated ?? false;
    }
}
