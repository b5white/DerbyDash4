@page "/api-race-history"
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Race History - API Demo</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>🏁 Race History (API Demo)</h2>
                <div class="btn-group">
                    <button class="btn btn-outline-primary" @onclick="RefreshData">
                        <i class="fas fa-refresh"></i> Refresh
                    </button>
                    <button class="btn btn-outline-success" @onclick="LoadStats">
                        <i class="fas fa-chart-bar"></i> Load Stats
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading race history...</span>
            </div>
            <p class="mt-2">Loading race history...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @errorMessage
        </div>
    }
    else
    {
        <!-- Race Statistics Card -->
        @if (raceStats != null)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">📊 Race Statistics</h5>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-number">@raceStats.TotalRaces</div>
                                <div class="stat-label">Total Races</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-number">@raceStats.AverageTime.ToString("F2")s</div>
                                <div class="stat-label">Average Time</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-number">@raceStats.BestTime.ToString("F2")s</div>
                                <div class="stat-label">Best Time</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-number">@raceStats.FirstPlaceFinishes</div>
                                <div class="stat-label">First Places</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Race History Table -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">🏎️ Recent Races</h5>
                
                @if (raceHistory?.Items?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Date</th>
                                    <th>Problem Set</th>
                                    <th>Total Time</th>
                                    <th>Position</th>
                                    <th>Speed Data</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var race in raceHistory.Items)
                                {
                                    <tr>
                                        <td>@race.RaceDateTime.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge bg-info">@GetProblemSetName(race.ProblemSetId)</span>
                                        </td>
                                        <td>
                                            <strong class="text-success">@race.TotalTime.ToString("F2")s</strong>
                                        </td>
                                        <td>
                                            @if (race.FinishingPosition == 1)
                                            {
                                                <span class="badge bg-warning text-dark">🥇 1st</span>
                                            }
                                            else if (race.FinishingPosition == 2)
                                            {
                                                <span class="badge bg-secondary">🥈 2nd</span>
                                            }
                                            else if (race.FinishingPosition == 3)
                                            {
                                                <span class="badge bg-dark">🥉 3rd</span>
                                            }
                                            else if (race.FinishingPosition > 0)
                                            {
                                                <span class="badge bg-light text-dark">@race.FinishingPosition</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (race.SpeedIncrements?.Any() == true)
                                            {
                                                <span class="badge bg-primary">@race.SpeedIncrements.Count increments</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No data</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-info" @onclick="() => ViewRaceDetails(race.Id)">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => DeleteRace(race.Id)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (raceHistory.TotalPages > 1)
                    {
                        <nav aria-label="Race history pagination" class="mt-3">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(raceHistory.HasPreviousPage ? "" : "disabled")">
                                    <button class="page-link" @onclick="() => LoadPage(currentPage - 1)" disabled="@(!raceHistory.HasPreviousPage)">
                                        Previous
                                    </button>
                                </li>
                                
                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(raceHistory.TotalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <button class="page-link" @onclick="() => LoadPage(i)">@i</button>
                                    </li>
                                }
                                
                                <li class="page-item @(raceHistory.HasNextPage ? "" : "disabled")">
                                    <button class="page-link" @onclick="() => LoadPage(currentPage + 1)" disabled="@(!raceHistory.HasNextPage)">
                                        Next
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-trophy fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No race history found</h5>
                        <p class="text-muted">Complete some races to see your history here!</p>
                        <a href="/api-race/addition-4stable" class="btn btn-primary">
                            <i class="fas fa-play me-2"></i>Start Racing
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private PaginatedResponse<RaceDto>? raceHistory;
    private dynamic? raceStats;
    private bool isLoading = true;
    private string? errorMessage;
    private int currentPage = 1;
    private const int pageSize = 10;

    protected override async Task OnInitializedAsync() {
        await LoadData();
        await LoadStats();
    }

    private async Task LoadData() {
        try {
            isLoading = true;
            errorMessage = null;

            var response = await Http.GetAsync($"/api/race/history?page={currentPage}&pageSize={pageSize}");
            if (response.IsSuccessStatusCode) {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<PaginatedResponse<RaceDto>>>();
                if (apiResponse?.Success == true) {
                    raceHistory = apiResponse.Data;
                } else {
                    errorMessage = apiResponse?.Message ?? "Failed to load race history";
                }
            } else {
                errorMessage = $"HTTP {response.StatusCode}: {response.ReasonPhrase}";
            }
        } catch (Exception ex) {
            errorMessage = $"Error loading race history: {ex.Message}";
        } finally {
            isLoading = false;
        }
    }

    private async Task LoadStats() {
        try {
            var response = await Http.GetAsync("/api/race/stats");
            if (response.IsSuccessStatusCode) {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<JsonElement>>();
                if (apiResponse?.Success == true) {
                    var statsElement = apiResponse.Data;
                    raceStats = new {
                        TotalRaces = statsElement.GetProperty("totalRaces").GetInt32(),
                        AverageTime = statsElement.GetProperty("averageTime").GetDouble(),
                        BestTime = statsElement.GetProperty("bestTime").GetDouble(),
                        FirstPlaceFinishes = statsElement.GetProperty("firstPlaceFinishes").GetInt32()
                    };
                }
            }
        } catch (Exception ex) {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

    private async Task LoadPage(int page) {
        if (page < 1 || (raceHistory != null && page > raceHistory.TotalPages)) return;
        
        currentPage = page;
        await LoadData();
    }

    private async Task RefreshData() {
        await LoadData();
        await LoadStats();
    }

    private async Task ViewRaceDetails(int raceId) {
        try {
            var response = await Http.GetAsync($"/api/race/{raceId}");
            if (response.IsSuccessStatusCode) {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<RaceDto>>();
                if (apiResponse?.Success == true && apiResponse.Data != null) {
                    var race = apiResponse.Data;
                    var details = $"Race Details:\\n" +
                                 $"Date: {race.RaceDateTime}\\n" +
                                 $"Total Time: {race.TotalTime:F2}s\\n" +
                                 $"Position: {race.FinishingPosition}\\n" +
                                 $"Speed Increments: {race.SpeedIncrements?.Count ?? 0}";
                    
                    await JS.InvokeVoidAsync("alert", details);
                }
            }
        } catch (Exception ex) {
            await JS.InvokeVoidAsync("alert", $"Error loading race details: {ex.Message}");
        }
    }

    private async Task DeleteRace(int raceId) {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this race?");
        if (!confirmed) return;

        try {
            var response = await Http.DeleteAsync($"/api/race/{raceId}");
            if (response.IsSuccessStatusCode) {
                await RefreshData();
                await JS.InvokeVoidAsync("alert", "Race deleted successfully");
            } else {
                await JS.InvokeVoidAsync("alert", "Failed to delete race");
            }
        } catch (Exception ex) {
            await JS.InvokeVoidAsync("alert", $"Error deleting race: {ex.Message}");
        }
    }

    private string GetProblemSetName(int problemSetId) {
        return problemSetId switch {
            1 => "Addition 4",
            2 => "Addition 6", 
            3 => "Subtraction 4",
            4 => "Subtraction 6",
            5 => "Multiplication 4",
            6 => "Multiplication 6",
            7 => "Division 4",
            8 => "Division 6",
            9 => "Mixed 4",
            10 => "Mixed 6",
            _ => $"Set {problemSetId}"
        };
    }
}

<style>
    .stat-item {
        text-align: center;
        padding: 1rem;
        border-radius: 8px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        margin-bottom: 1rem;
    }
    
    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: #0066cc;
        margin-bottom: 0.5rem;
    }
    
    .stat-label {
        font-size: 0.9rem;
        color: #6c757d;
        font-weight: 500;
    }
    
    .table th {
        border-top: none;
        font-weight: 600;
        font-size: 0.875rem;
    }
    
    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
    
    .badge {
        font-size: 0.8em;
    }
    
    .page-link {
        color: #0066cc;
    }
    
    .page-item.active .page-link {
        background-color: #0066cc;
        border-color: #0066cc;
    }
</style>
