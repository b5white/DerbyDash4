@page "/api-auth"
@inject HttpClient Http
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>API Authentication Demo</PageTitle>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>🔐 API Authentication Demo</h2>
                <div class="btn-group">
                    @if (!string.IsNullOrEmpty(currentToken))
                    {
                        <button class="btn btn-outline-danger" @onclick="Logout">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </button>
                    }
                </div>
            </div>

            @if (errorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @errorMessage
                </div>
            }

            @if (successMessage != null)
            {
                <div class="alert alert-success" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    @successMessage
                </div>
            }

            @if (string.IsNullOrEmpty(currentToken))
            {
                <!-- Login/Register Forms -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">🔑 Login</h5>
                                <EditForm Model="loginModel" OnValidSubmit="LoginAsync">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-danger" />
                                    
                                    <div class="mb-3">
                                        <label for="loginEmail" class="form-label">Email</label>
                                        <InputText id="loginEmail" class="form-control" @bind-Value="loginModel.Email" />
                                        <ValidationMessage For="() => loginModel.Email" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="loginPassword" class="form-label">Password</label>
                                        <InputText id="loginPassword" type="password" class="form-control" @bind-Value="loginModel.Password" />
                                        <ValidationMessage For="() => loginModel.Password" />
                                    </div>
                                    
                                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                        @if (isLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        Login
                                    </button>
                                </EditForm>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">📝 Register</h5>
                                <EditForm Model="registerModel" OnValidSubmit="RegisterAsync">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-danger" />
                                    
                                    <div class="mb-3">
                                        <label for="registerEmail" class="form-label">Email</label>
                                        <InputText id="registerEmail" class="form-control" @bind-Value="registerModel.Email" />
                                        <ValidationMessage For="() => registerModel.Email" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="registerPassword" class="form-label">Password</label>
                                        <InputText id="registerPassword" type="password" class="form-control" @bind-Value="registerModel.Password" />
                                        <ValidationMessage For="() => registerModel.Password" />
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="confirmPassword" class="form-label">Confirm Password</label>
                                        <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="registerModel.ConfirmPassword" />
                                        <ValidationMessage For="() => registerModel.ConfirmPassword" />
                                    </div>
                                    
                                    <button type="submit" class="btn btn-success" disabled="@isLoading">
                                        @if (isLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        Register
                                    </button>
                                </EditForm>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Authenticated User Info -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">✅ Authenticated User</h5>
                        @if (currentUser != null)
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Email:</strong> @currentUser.Email</p>
                                    <p><strong>Username:</strong> @currentUser.UserName</p>
                                    <p><strong>User ID:</strong> @currentUser.Id</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Email Confirmed:</strong> @(currentUser.EmailConfirmed ? "✅ Yes" : "❌ No")</p>
                                    <p><strong>Token Expires:</strong> @tokenExpiryTime?.ToString("yyyy-MM-dd HH:mm:ss")</p>
                                </div>
                            </div>
                        }
                        
                        <div class="mt-3">
                            <details>
                                <summary class="btn btn-outline-info btn-sm">View JWT Token</summary>
                                <div class="mt-2">
                                    <small class="font-monospace text-muted" style="word-break: break-all;">@currentToken</small>
                                </div>
                            </details>
                        </div>
                    </div>
                </div>

                <!-- API Test Section -->
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">🧪 Test API Endpoints</h5>
                        <p class="text-muted">Test various API endpoints with your JWT token</p>
                        
                        <div class="row g-3">
                            <div class="col-md-4">
                                <button class="btn btn-outline-primary w-100" @onclick="TestGetUser">
                                    <i class="fas fa-user"></i> Get User Info
                                </button>
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-outline-primary w-100" @onclick="TestGetRacers">
                                    <i class="fas fa-car"></i> Get Racers
                                </button>
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-outline-primary w-100" @onclick="TestGetRaceHistory">
                                    <i class="fas fa-history"></i> Get Race History
                                </button>
                            </div>
                        </div>
                        
                        @if (apiTestResult != null)
                        {
                            <div class="mt-3">
                                <h6>API Test Result:</h6>
                                <div class="alert @(apiTestResult.Contains("Error") ? "alert-danger" : "alert-info")">
                                    <pre style="white-space: pre-wrap; margin: 0;">@apiTestResult</pre>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private RegisterRequest registerModel = new();
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;
    private string? currentToken;
    private string? refreshToken;
    private UserDto? currentUser;
    private DateTime? tokenExpiryTime;
    private string? apiTestResult;

    protected override async Task OnInitializedAsync() {
        // Check if there's a stored token in localStorage
        try {
            currentToken = await JS.InvokeAsync<string?>("localStorage.getItem", "jwtToken");
            refreshToken = await JS.InvokeAsync<string?>("localStorage.getItem", "refreshToken");
            
            if (!string.IsNullOrEmpty(currentToken)) {
                await LoadCurrentUser();
            }
        } catch {
            // localStorage might not be available
        }
    }

    private async Task LoginAsync() {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try {
            var response = await Http.PostAsJsonAsync("/api/auth/login", loginModel);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<LoginResponse>>();

            if (result?.Success == true && result.Data != null) {
                currentToken = result.Data.AccessToken;
                refreshToken = result.Data.RefreshToken;
                currentUser = result.Data.User;
                tokenExpiryTime = DateTime.UtcNow.AddSeconds(result.Data.ExpiresIn);
                
                // Store tokens in localStorage
                await JS.InvokeVoidAsync("localStorage.setItem", "jwtToken", currentToken);
                await JS.InvokeVoidAsync("localStorage.setItem", "refreshToken", refreshToken);
                
                successMessage = "Login successful!";
                loginModel = new LoginRequest(); // Clear form
            } else {
                errorMessage = result?.Message ?? "Login failed";
            }
        } catch (Exception ex) {
            errorMessage = $"Login error: {ex.Message}";
        } finally {
            isLoading = false;
        }
    }

    private async Task RegisterAsync() {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try {
            var response = await Http.PostAsJsonAsync("/api/auth/register", registerModel);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<LoginResponse>>();

            if (result?.Success == true && result.Data != null) {
                currentToken = result.Data.AccessToken;
                refreshToken = result.Data.RefreshToken;
                currentUser = result.Data.User;
                tokenExpiryTime = DateTime.UtcNow.AddSeconds(result.Data.ExpiresIn);
                
                // Store tokens in localStorage
                await JS.InvokeVoidAsync("localStorage.setItem", "jwtToken", currentToken);
                await JS.InvokeVoidAsync("localStorage.setItem", "refreshToken", refreshToken);
                
                successMessage = "Registration successful!";
                registerModel = new RegisterRequest(); // Clear form
            } else {
                errorMessage = result?.Message ?? "Registration failed";
            }
        } catch (Exception ex) {
            errorMessage = $"Registration error: {ex.Message}";
        } finally {
            isLoading = false;
        }
    }

    private async Task LoadCurrentUser() {
        try {
            if (string.IsNullOrEmpty(currentToken)) return;

            var request = new HttpRequestMessage(HttpMethod.Get, "/api/auth/me");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", currentToken);
            
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode) {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse<UserDto>>();
                if (result?.Success == true) {
                    currentUser = result.Data;
                }
            } else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized) {
                // Token expired, clear it
                await Logout();
            }
        } catch (Exception ex) {
            errorMessage = $"Error loading user: {ex.Message}";
        }
    }

    private async Task Logout() {
        try {
            if (!string.IsNullOrEmpty(refreshToken)) {
                var logoutRequest = new LogoutRequest { RefreshToken = refreshToken };
                var request = new HttpRequestMessage(HttpMethod.Post, "/api/auth/logout") {
                    Content = JsonContent.Create(logoutRequest)
                };
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", currentToken);
                
                await Http.SendAsync(request);
            }
        } catch {
            // Ignore logout errors
        } finally {
            // Clear local state
            currentToken = null;
            refreshToken = null;
            currentUser = null;
            tokenExpiryTime = null;
            apiTestResult = null;
            
            // Clear localStorage
            await JS.InvokeVoidAsync("localStorage.removeItem", "jwtToken");
            await JS.InvokeVoidAsync("localStorage.removeItem", "refreshToken");
            
            successMessage = "Logged out successfully";
        }
    }

    private async Task TestGetUser() {
        await TestApiEndpoint("/api/auth/me", "GET");
    }

    private async Task TestGetRacers() {
        await TestApiEndpoint("/api/racers", "GET");
    }

    private async Task TestGetRaceHistory() {
        await TestApiEndpoint("/api/race/history?page=1&pageSize=5", "GET");
    }

    private async Task TestApiEndpoint(string endpoint, string method) {
        try {
            var request = new HttpRequestMessage(new HttpMethod(method), endpoint);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", currentToken);
            
            var response = await Http.SendAsync(request);
            var content = await response.Content.ReadAsStringAsync();
            
            apiTestResult = $"Status: {response.StatusCode}\n\nResponse:\n{content}";
        } catch (Exception ex) {
            apiTestResult = $"Error: {ex.Message}";
        }
    }
}

<style>
    .card {
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    
    .btn {
        border-radius: 8px;
    }
    
    .alert {
        border-radius: 10px;
    }
    
    .font-monospace {
        font-family: 'Courier New', monospace;
        font-size: 0.875rem;
    }
    
    pre {
        font-size: 0.875rem;
    }
    
    details summary {
        cursor: pointer;
    }
    
    details[open] summary {
        margin-bottom: 0.5rem;
    }
</style>
