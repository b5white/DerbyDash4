@page "/api-raceteam"
@rendermode InteractiveServer
@attribute [Authorize]
@using DerbyDash.Shared.DTOs
@using DerbyDash.Shared.Models
@using System.Text.Json
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

<PageTitle>API Race Team</PageTitle>

<div class="container">
    <h1>API-Based Race Team Management</h1>
    <p class="text-muted">This page uses API calls to manage racers</p>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">
            @ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success">
            @SuccessMessage
        </div>
    }

    @if (IsLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading racers...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3>Current Racers</h3>
                        <button class="btn btn-primary" @onclick="ShowAddRacerModal">
                            <i class="fas fa-plus"></i> Add Racer
                        </button>
                    </div>
                    <div class="card-body">
                        @if (!Racers.Any())
                        {
                            <div class="text-center text-muted">
                                <p>No racers found. Add your first racer to get started!</p>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                @foreach (var racer in Racers)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card @(racer.Id == ActiveRacer?.Id ? "border-primary" : "")">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div class="flex-grow-1">
                                                        <h5 class="card-title">
                                                            @racer.Name
                                                            @if (racer.Id == ActiveRacer?.Id)
                                                            {
                                                                <span class="badge bg-primary ms-2">Active</span>
                                                            }
                                                        </h5>
                                                        <p class="card-text">
                                                            <small class="text-muted">
                                                                Race Count: @racer.RaceCount<br />
                                                                @if (racer.LastRaced.HasValue)
                                                                {
                                                                    <text>Last Raced: @racer.LastRaced.Value.ToString("MM/dd/yyyy")</text><br />
                                                                }
                                                                @if (!string.IsNullOrEmpty(racer.LastPlayedRace))
                                                                {
                                                                    <text>Last Game: @racer.LastPlayedRace</text>
                                                                }
                                                            </small>
                                                        </p>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(racer.AvatarFileName))
                                                    {
                                                        <img src="/images/avatars/@racer.AvatarFileName" 
                                                             alt="Avatar" class="avatar-small" />
                                                    }
                                                </div>
                                                <div class="btn-group btn-group-sm w-100" role="group">
                                                    @if (racer.Id != ActiveRacer?.Id)
                                                    {
                                                        <button class="btn btn-outline-success" 
                                                                @onclick="() => SetActiveRacer(racer.Id)"
                                                                disabled="@IsProcessing">
                                                            Set Active
                                                        </button>
                                                    }
                                                    <button class="btn btn-outline-primary" 
                                                            @onclick="() => EditRacer(racer)"
                                                            disabled="@IsProcessing">
                                                        Edit
                                                    </button>
                                                    <button class="btn btn-outline-danger" 
                                                            @onclick="() => DeleteRacer(racer.Id)"
                                                            disabled="@IsProcessing">
                                                        Delete
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h4>Team Stats</h4>
                    </div>
                    <div class="card-body">
                        @if (Stats != null)
                        {
                            <p><strong>Total Team Races:</strong> @Stats.TeamRaceCount</p>
                            <p><strong>Active Racer Races:</strong> @Stats.CurrentRacerRaceCount</p>
                            @if (!string.IsNullOrEmpty(Stats.LastPlayedRace))
                            {
                                <p><strong>Last Game:</strong> @Stats.LastPlayedRace</p>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Loading stats...</p>
                        }
                    </div>
                </div>

                @if (ActiveRacer != null)
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <h4>Active Racer</h4>
                        </div>
                        <div class="card-body text-center">
                            @if (!string.IsNullOrEmpty(ActiveRacer.AvatarFileName))
                            {
                                <img src="/images/avatars/@ActiveRacer.AvatarFileName" 
                                     alt="Avatar" class="avatar-large mb-2" />
                            }
                            <h5>@ActiveRacer.Name</h5>
                            <p class="text-muted">Ready to race!</p>
                            <a href="/api-race/addition-4stable" class="btn btn-success">
                                Start Racing!
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Add/Edit Racer Modal -->
@if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditingRacer == null ? "Add New Racer" : "Edit Racer")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="RacerForm" OnValidSubmit="SaveRacer">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="RacerForm.Name" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Avatar</label>
                            <select class="form-select" @bind="RacerForm.AvatarFileName">
                                <option value="">No Avatar</option>
                                @foreach (var avatar in AvailableAvatars)
                                {
                                    <option value="@avatar">@avatar</option>
                                }
                            </select>
                        </div>
                        
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@IsProcessing">
                                @if (IsProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(EditingRacer == null ? "Add Racer" : "Update Racer")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private List<RacerDto> Racers = new();
    private RacerDto? ActiveRacer;
    private bool IsLoading = true;
    private bool IsProcessing = false;
    private bool ShowModal = false;
    private string ErrorMessage = "";
    private string SuccessMessage = "";
    private RacerDto? EditingRacer;
    private RacerFormModel RacerForm = new();
    private RacerStatsModel? Stats;

    private readonly List<string> AvailableAvatars = new() {
        "1.png", "2.png", "3.png", "4.png", "5.png", "6.png", "7.png", "8.png"
    };

    protected override async Task OnInitializedAsync() {
        await LoadData();
    }

    private async Task LoadData() {
        IsLoading = true;
        ErrorMessage = "";
        
        try {
            await Task.WhenAll(
                LoadRacers(),
                LoadActiveRacer(),
                LoadStats()
            );
        } catch (Exception ex) {
            ErrorMessage = $"Error loading data: {ex.Message}";
        } finally {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadRacers() {
        var response = await Http.GetAsync("/api/racers");
        if (response.IsSuccessStatusCode) {
            var content = await response.Content.ReadAsStringAsync();
            var apiResponse = JsonSerializer.Deserialize<ApiResponse<List<RacerDto>>>(content, 
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            if (apiResponse?.Success == true && apiResponse.Data != null) {
                Racers = apiResponse.Data;
            }
        }
    }

    private async Task LoadActiveRacer() {
        var response = await Http.GetAsync("/api/racers/active");
        if (response.IsSuccessStatusCode) {
            var content = await response.Content.ReadAsStringAsync();
            var apiResponse = JsonSerializer.Deserialize<ApiResponse<RacerDto?>>(content, 
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            if (apiResponse?.Success == true) {
                ActiveRacer = apiResponse.Data;
            }
        }
    }

    private async Task LoadStats() {
        var response = await Http.GetAsync("/api/racers/stats");
        if (response.IsSuccessStatusCode) {
            var content = await response.Content.ReadAsStringAsync();
            var apiResponse = JsonSerializer.Deserialize<ApiResponse<RacerStatsModel>>(content, 
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            if (apiResponse?.Success == true) {
                Stats = apiResponse.Data;
            }
        }
    }

    private void ShowAddRacerModal() {
        EditingRacer = null;
        RacerForm = new RacerFormModel();
        ShowModal = true;
    }

    private void EditRacer(RacerDto racer) {
        EditingRacer = racer;
        RacerForm = new RacerFormModel {
            Name = racer.Name,
            AvatarFileName = racer.AvatarFileName
        };
        ShowModal = true;
    }

    private void CloseModal() {
        ShowModal = false;
        EditingRacer = null;
        RacerForm = new RacerFormModel();
    }

    private async Task SaveRacer() {
        IsProcessing = true;
        ErrorMessage = "";
        SuccessMessage = "";

        try {
            HttpResponseMessage response;
            string content;

            if (EditingRacer == null) {
                // Create new racer
                var createRequest = new CreateRacerRequest {
                    Name = RacerForm.Name,
                    AvatarFileName = RacerForm.AvatarFileName
                };

                content = JsonSerializer.Serialize(createRequest);
                response = await Http.PostAsync("/api/racers", 
                    new StringContent(content, Encoding.UTF8, "application/json"));
            } else {
                // Update existing racer
                var updateRequest = new UpdateRacerRequest {
                    Id = EditingRacer.Id,
                    Name = RacerForm.Name,
                    AvatarFileName = RacerForm.AvatarFileName
                };

                content = JsonSerializer.Serialize(updateRequest);
                response = await Http.PutAsync($"/api/racers/{EditingRacer.Id}", 
                    new StringContent(content, Encoding.UTF8, "application/json"));
            }

            if (response.IsSuccessStatusCode) {
                SuccessMessage = EditingRacer == null ? 
                    "Racer added successfully!" : 
                    "Racer updated successfully!";
                CloseModal();
                await LoadData();
            } else {
                var errorContent = await response.Content.ReadAsStringAsync();
                var errorResponse = JsonSerializer.Deserialize<ApiResponse<object>>(errorContent, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ErrorMessage = errorResponse?.Message ?? "Error saving racer";
            }
        } catch (Exception ex) {
            ErrorMessage = $"Error saving racer: {ex.Message}";
        } finally {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task SetActiveRacer(int racerId) {
        IsProcessing = true;
        ErrorMessage = "";
        SuccessMessage = "";

        try {
            var response = await Http.PostAsync($"/api/racers/{racerId}/set-active", null);
            
            if (response.IsSuccessStatusCode) {
                SuccessMessage = "Active racer updated!";
                await LoadData();
            } else {
                var errorContent = await response.Content.ReadAsStringAsync();
                var errorResponse = JsonSerializer.Deserialize<ApiResponse<object>>(errorContent, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ErrorMessage = errorResponse?.Message ?? "Error setting active racer";
            }
        } catch (Exception ex) {
            ErrorMessage = $"Error setting active racer: {ex.Message}";
        } finally {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DeleteRacer(int racerId) {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this racer? This action cannot be undone.")) {
            return;
        }

        IsProcessing = true;
        ErrorMessage = "";
        SuccessMessage = "";

        try {
            var response = await Http.DeleteAsync($"/api/racers/{racerId}");
            
            if (response.IsSuccessStatusCode) {
                SuccessMessage = "Racer deleted successfully!";
                await LoadData();
            } else {
                var errorContent = await response.Content.ReadAsStringAsync();
                var errorResponse = JsonSerializer.Deserialize<ApiResponse<object>>(errorContent, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ErrorMessage = errorResponse?.Message ?? "Error deleting racer";
            }
        } catch (Exception ex) {
            ErrorMessage = $"Error deleting racer: {ex.Message}";
        } finally {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private class RacerFormModel {
        public string Name { get; set; } = "";
        public string? AvatarFileName { get; set; }
    }

    private class RacerStatsModel {
        public int TeamRaceCount { get; set; }
        public int CurrentRacerRaceCount { get; set; }
        public string? LastPlayedRace { get; set; }
    }
}

<style>
    .avatar-small {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }
    
    .avatar-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
    }

    .modal.show {
        display: block !important;
    }
</style>
