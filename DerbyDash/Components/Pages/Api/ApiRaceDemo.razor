@page "/api-race-demo/{problemClassString}"
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>API Race Demo - @problemClassString</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>🏁 API Race Demo - @GetProblemDisplayName(problemClassString)</h2>
                <div class="btn-group">
                    <button class="btn btn-outline-primary" @onclick="LoadActiveRacer">
                        <i class="fas fa-user"></i> Refresh Racer
                    </button>
                    <a href="/api-race-history" class="btn btn-outline-info">
                        <i class="fas fa-history"></i> View History
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @errorMessage
        </div>
    }

    @if (activeRacer != null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">👤 Active Racer</h5>
                <div class="d-flex align-items-center">
                    @if (!string.IsNullOrEmpty(activeRacer.AvatarFileName))
                    {
                        <img src="/images/Avatars/@activeRacer.AvatarFileName" alt="@activeRacer.Name" 
                             class="rounded-circle me-3" style="width: 50px; height: 50px;">
                    }
                    <div>
                        <h6 class="mb-1">@activeRacer.Name</h6>
                        <small class="text-muted">@activeRacer.RaceCount races completed</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">🎯 Race Simulation</h5>
            
            @if (!raceStarted)
            {
                <div class="text-center py-5">
                    <button class="btn btn-primary btn-lg" @onclick="StartRace" disabled="@(activeRacer == null)">
                        <i class="fas fa-play me-2"></i>Start Race
                    </button>
                    @if (activeRacer == null)
                    {
                        <p class="text-muted mt-2">Please select an active racer first</p>
                    }
                </div>
            }
            else if (raceInProgress)
            {
                <div class="text-center py-5">
                    <div class="progress mb-3" style="height: 30px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" 
                             role="progressbar" style="width: @(raceProgress)%" 
                             aria-valuenow="@raceProgress" aria-valuemin="0" aria-valuemax="100">
                            @raceProgress.ToString("F0")%
                        </div>
                    </div>
                    <p class="lead">Racing in progress... Time: @currentTime.ToString("F2")s</p>
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Racing...</span>
                    </div>
                </div>
            }
            else if (raceCompleted)
            {
                <div class="text-center py-5">
                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-heading">🏆 Race Complete!</h4>
                        <p class="mb-0">Total Time: <strong>@totalTime.ToString("F2") seconds</strong></p>
                        <p class="mb-0">Finishing Position: <strong>@finishingPosition</strong></p>
                    </div>
                    
                    @if (isSaving)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary me-2" role="status">
                                <span class="visually-hidden">Saving...</span>
                            </div>
                            <span>Saving race results...</span>
                        </div>
                    }
                    else if (saveSuccess)
                    {
                        <div class="alert alert-info mt-3">
                            <i class="fas fa-check-circle me-2"></i>
                            Race saved successfully! Race ID: @savedRaceId
                        </div>
                    }
                    else if (saveError != null)
                    {
                        <div class="alert alert-warning mt-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @saveError
                        </div>
                    }
                    
                    <div class="mt-4">
                        <button class="btn btn-primary me-2" @onclick="StartRace">
                            <i class="fas fa-redo me-2"></i>Race Again
                        </button>
                        <button class="btn btn-outline-primary me-2" @onclick="SaveRaceManually" disabled="@(saveSuccess || isSaving)">
                            <i class="fas fa-save me-2"></i>Save Results
                        </button>
                        <a href="/api-race-history" class="btn btn-outline-info">
                            <i class="fas fa-history me-2"></i>View History
                        </a>
                    </div>
                </div>
            }

            @if (speedIncrements.Any())
            {
                <div class="mt-4">
                    <h6>📈 Speed Data</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Speed</th>
                                    <th>Distance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var increment in speedIncrements.Take(5))
                                {
                                    <tr>
                                        <td>@increment.Time.ToString("F2")s</td>
                                        <td>@increment.Speed.ToString("F1")</td>
                                        <td>@increment.Distance.ToString("F1")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (speedIncrements.Count > 5)
                        {
                            <small class="text-muted">... and @(speedIncrements.Count - 5) more</small>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string problemClassString { get; set; } = "";
    
    private RacerDto? activeRacer;
    private bool raceStarted = false;
    private bool raceInProgress = false;
    private bool raceCompleted = false;
    private double raceProgress = 0;
    private double currentTime = 0;
    private double totalTime = 0;
    private int finishingPosition = 1;
    private List<SpeedIncrementData> speedIncrements = new();
    private Timer? raceTimer;
    private string? errorMessage;
    
    // Save state
    private bool isSaving = false;
    private bool saveSuccess = false;
    private string? saveError;
    private int? savedRaceId;

    protected override async Task OnInitializedAsync() {
        await LoadActiveRacer();
    }

    protected override async Task OnParametersSetAsync() {
        // Reset race state when problem type changes
        ResetRace();
        await LoadActiveRacer();
    }

    private async Task LoadActiveRacer() {
        try {
            errorMessage = null;
            var response = await Http.GetAsync("/api/racers/active");
            if (response.IsSuccessStatusCode) {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<RacerDto>>();
                if (apiResponse?.Success == true) {
                    activeRacer = apiResponse.Data;
                } else {
                    errorMessage = "No active racer found. Please select a racer from your team.";
                }
            } else {
                errorMessage = $"Failed to load active racer: {response.ReasonPhrase}";
            }
        } catch (Exception ex) {
            errorMessage = $"Error loading active racer: {ex.Message}";
        }
    }

    private async Task StartRace() {
        if (activeRacer == null) {
            errorMessage = "No active racer selected";
            return;
        }

        ResetRace();
        raceStarted = true;
        raceInProgress = true;
        
        // Start the race simulation
        raceTimer = new Timer(UpdateRaceProgress, null, 100, 100);
    }

    private void UpdateRaceProgress(object? state) {
        if (!raceInProgress) return;

        currentTime += 0.1;
        raceProgress = Math.Min(100, (currentTime / 15.0) * 100); // 15 second race
        
        // Add speed increments periodically
        if (currentTime % 1.0 < 0.1) { // Every second
            speedIncrements.Add(new SpeedIncrementData {
                Time = currentTime,
                Speed = Random.Shared.NextDouble() * 10 + 5, // 5-15 speed
                Distance = raceProgress * 2 // Simple distance calculation
            });
        }

        if (currentTime >= 15.0) {
            CompleteRace();
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task CompleteRace() {
        raceInProgress = false;
        raceCompleted = true;
        totalTime = currentTime;
        finishingPosition = Random.Shared.Next(1, 4); // Random position 1-3
        
        raceTimer?.Dispose();
        raceTimer = null;

        // Auto-save the race
        await SaveRaceToAPI();
        
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveRaceManually() {
        await SaveRaceToAPI();
    }

    private async Task SaveRaceToAPI() {
        if (isSaving || saveSuccess) return;

        try {
            isSaving = true;
            saveError = null;
            StateHasChanged();

            var saveRequest = new SaveRaceRequest {
                TotalTime = totalTime,
                ProblemClassString = problemClassString,
                FinishingPosition = finishingPosition,
                SpeedIncrements = speedIncrements
            };

            var response = await Http.PostAsJsonAsync("/api/race/save", saveRequest);
            
            if (response.IsSuccessStatusCode) {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<RaceDto>>();
                if (apiResponse?.Success == true && apiResponse.Data != null) {
                    saveSuccess = true;
                    savedRaceId = apiResponse.Data.Id;
                } else {
                    saveError = apiResponse?.Message ?? "Failed to save race";
                }
            } else {
                var errorContent = await response.Content.ReadAsStringAsync();
                saveError = $"HTTP {response.StatusCode}: {errorContent}";
            }
        } catch (Exception ex) {
            saveError = $"Error saving race: {ex.Message}";
        } finally {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ResetRace() {
        raceStarted = false;
        raceInProgress = false;
        raceCompleted = false;
        raceProgress = 0;
        currentTime = 0;
        totalTime = 0;
        finishingPosition = 1;
        speedIncrements.Clear();
        
        // Reset save state
        isSaving = false;
        saveSuccess = false;
        saveError = null;
        savedRaceId = null;
        
        raceTimer?.Dispose();
        raceTimer = null;
    }

    private string GetProblemDisplayName(string problemClass) {
        return problemClass switch {
            "addition-4stable" => "Addition (4 digits)",
            "addition-6stable" => "Addition (6 digits)",
            "subtraction-4stable" => "Subtraction (4 digits)",
            "subtraction-6stable" => "Subtraction (6 digits)",
            "multiplication-4stable" => "Multiplication (4 digits)",
            "multiplication-6stable" => "Multiplication (6 digits)",
            "division-4stable" => "Division (4 digits)",
            "division-6stable" => "Division (6 digits)",
            "mixed-4stable" => "Mixed Operations (4 digits)",
            "mixed-6stable" => "Mixed Operations (6 digits)",
            _ => problemClass
        };
    }

    public void Dispose() {
        raceTimer?.Dispose();
    }
}

<style>
    .progress {
        border-radius: 10px;
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
    }
    
    .progress-bar {
        border-radius: 10px;
        background: linear-gradient(45deg, #007bff, #0056b3);
    }
    
    .card {
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    
    .btn {
        border-radius: 8px;
    }
    
    .alert {
        border-radius: 10px;
    }
    
    .table th {
        border-top: none;
        font-weight: 600;
        color: #495057;
    }
</style>
