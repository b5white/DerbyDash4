@page "/api-race/{ProblemClassString}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using DerbyDash.Shared.Problems
@using DerbyDash.Shared.DTOs
@using System.Text.Json
@using System.Text

<h1>API-Based Race: @GetTitle()</h1>

@if (!Started)
{
    <h2>Ready to Race?</h2>
    <p>This is using API calls instead of server-side components.</p>
    <button @onclick="StartRace" class="btn btn-primary">Start Race</button>
}
else if (CurrentProblemIndex < Problems.Count)
{
    <div class="race-container">
        <h2>Problem @(CurrentProblemIndex + 1) of @Problems.Count</h2>
        <h3>@CurrentProblem?.Description</h3>
        <input @bind="Answer" @onkeypress="@(async (e) => { if (e.Key == "Enter") await CheckAnswer(); })" 
               class="form-control" style="width: 200px; font-size: 24px;" 
               @ref="answerInput" autofocus />
        <br />
        <button @onclick="CheckAnswer" class="btn btn-success mt-2">Submit</button>
        
        <div class="mt-3">
            <p>Correct Answers: @CorrectAnswers</p>
            <p>Time Elapsed: @TimeElapsed.ToString("F1") seconds</p>
        </div>
    </div>
}
else
{
    <div class="race-finished">
        <h2>Race Complete!</h2>
        <p>Total Time: @TotalTime.ToString("F2") seconds</p>
        <p>Correct Answers: @CorrectAnswers out of @Problems.Count</p>
        <p>Average Time per Problem: @(Problems.Count > 0 ? (TotalTime / Problems.Count).ToString("F2") : "0") seconds</p>
        <button @onclick="RestartRace" class="btn btn-primary">Try Again</button>
    </div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        @ErrorMessage
    </div>
}

@code {
    [Parameter] public string? ProblemClassString { get; set; }
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private List<ProblemDto> Problems = new();
    private ProblemDto? CurrentProblem => CurrentProblemIndex < Problems.Count ? Problems[CurrentProblemIndex] : null;
    private int CurrentProblemIndex = 0;
    private string Answer = "";
    private bool Started = false;
    private DateTime StartTime;
    private DateTime ProblemStartTime;
    private double TotalTime = 0;
    private int CorrectAnswers = 0;
    private string ErrorMessage = "";
    private ElementReference answerInput;
    private string ProblemTitle = "";

    private double TimeElapsed => Started ? (DateTime.Now - ProblemStartTime).TotalSeconds : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadProblems();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Started && CurrentProblemIndex < Problems.Count)
        {
            try
            {
                await answerInput.FocusAsync();
            }
            catch { }
        }
    }

    private async Task LoadProblems()
    {
        try
        {
            ErrorMessage = "";
            var problemType = ProblemClassString ?? "addition-4stable";
            
            var response = await Http.GetAsync($"/api/problems/{problemType}");
            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var apiResponse = JsonSerializer.Deserialize<ApiResponse<ProblemSetDto>>(content, new JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true 
                });

                if (apiResponse?.Success == true && apiResponse.Data != null)
                {
                    Problems = apiResponse.Data.Problems;
                    ProblemTitle = apiResponse.Data.Title;
                }
                else
                {
                    ErrorMessage = apiResponse?.Message ?? "Failed to load problems";
                }
            }
            else
            {
                ErrorMessage = $"Failed to load problems: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading problems: {ex.Message}";
        }
    }

    private async Task StartRace()
    {
        if (Problems.Count == 0)
        {
            await LoadProblems();
            if (Problems.Count == 0) return;
        }

        Started = true;
        StartTime = DateTime.Now;
        ProblemStartTime = DateTime.Now;
        CurrentProblemIndex = 0;
        CorrectAnswers = 0;
        TotalTime = 0;
        Answer = "";
        ErrorMessage = "";

        await Task.Delay(100); // Small delay to ensure rendering
        StateHasChanged();
    }

    private async Task CheckAnswer()
    {
        if (CurrentProblem == null) return;

        if (Answer.Trim() == CurrentProblem.Result)
        {
            CorrectAnswers++;
        }

        // Move to next problem
        CurrentProblemIndex++;
        Answer = "";

        if (CurrentProblemIndex >= Problems.Count)
        {
            // Race finished
            TotalTime = (DateTime.Now - StartTime).TotalSeconds;
            Started = false;
        }
        else
        {
            // Start timing for next problem
            ProblemStartTime = DateTime.Now;
        }

        StateHasChanged();
    }

    private async Task RestartRace()
    {
        Started = false;
        CurrentProblemIndex = 0;
        Answer = "";
        CorrectAnswers = 0;
        TotalTime = 0;
        ErrorMessage = "";
        StateHasChanged();
    }

    private string GetTitle()
    {
        return string.IsNullOrEmpty(ProblemTitle) ? 
            $"API Race - {ProblemClassString}" : 
            ProblemTitle;
    }
}

<style>
    .race-container {
        text-align: center;
        padding: 20px;
    }
    
    .race-finished {
        text-align: center;
        padding: 20px;
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        border-radius: 5px;
    }
</style>
