@page "/offline-menu"
@rendermode InteractiveServer
@attribute [AllowAnonymous]

<div class="offline-menu-container">
    <div class="offline-header">
        <div class="offline-indicator">
            <i class="fas fa-wifi-slash"></i>
            <span>Offline Practice Mode</span>
        </div>
        <h1 class="offline-title">Practice Math Racing</h1>
        <p class="offline-subtitle">Keep practicing even without internet connection!</p>
    </div>

    <div class="practice-options">
        <div class="practice-grid">
            <a href="/offline-race/addition-4stable" class="practice-card addition">
                <div class="practice-icon">
                    <i class="fas fa-plus"></i>
                </div>
                <h3>Addition Practice</h3>
                <p>Practice addition problems and improve your speed!</p>
                <div class="practice-badge">
                    <span>4s Table</span>
                </div>
            </a>

            <a href="/offline-race/subtraction-4stable" class="practice-card subtraction">
                <div class="practice-icon">
                    <i class="fas fa-minus"></i>
                </div>
                <h3>Subtraction Practice</h3>
                <p>Master subtraction with racing excitement!</p>
                <div class="practice-badge">
                    <span>4s Table</span>
                </div>
            </a>

            <a href="/offline-race/multiplication-4stable" class="practice-card multiplication">
                <div class="practice-icon">
                    <i class="fas fa-times"></i>
                </div>
                <h3>Multiplication Practice</h3>
                <p>Speed through multiplication tables!</p>
                <div class="practice-badge">
                    <span>4s Table</span>
                </div>
            </a>

            <a href="/offline-race/addition-2stable" class="practice-card addition-alt">
                <div class="practice-icon">
                    <i class="fas fa-plus-circle"></i>
                </div>
                <h3>Addition 2s</h3>
                <p>Practice with 2s table addition problems!</p>
                <div class="practice-badge">
                    <span>2s Table</span>
                </div>
            </a>

            <a href="/offline-race/addition-3stable" class="practice-card addition-alt2">
                <div class="practice-icon">
                    <i class="fas fa-plus-square"></i>
                </div>
                <h3>Addition 3s</h3>
                <p>Challenge yourself with 3s table!</p>
                <div class="practice-badge">
                    <span>3s Table</span>
                </div>
            </a>

            <a href="/offline-race/addition-5stable" class="practice-card addition-alt3">
                <div class="practice-icon">
                    <i class="fas fa-calculator"></i>
                </div>
                <h3>Addition 5s</h3>
                <p>Master the 5s table with racing fun!</p>
                <div class="practice-badge">
                    <span>5s Table</span>
                </div>
            </a>
        </div>
    </div>

    <div class="offline-features">
        <h2>Offline Features</h2>
        <div class="features-grid">
            <div class="feature-item">
                <i class="fas fa-clock"></i>
                <h4>Track Your Times</h4>
                <p>Monitor your improvement during the session</p>
            </div>
            <div class="feature-item">
                <i class="fas fa-trophy"></i>
                <h4>Race Against Yourself</h4>
                <p>Compete with your previous session times</p>
            </div>
            <div class="feature-item">
                <i class="fas fa-chart-line"></i>
                <h4>See Progress</h4>
                <p>Watch your session stats improve</p>
            </div>
            <div class="feature-item">
                <i class="fas fa-mobile-alt"></i>
                <h4>Works Anywhere</h4>
                <p>Practice offline on any device</p>
            </div>
        </div>
    </div>

    <div class="offline-notice">
        <div class="notice-content">
            <i class="fas fa-info-circle"></i>
            <div>
                <strong>Note:</strong> Progress in offline mode is not saved to your account. 
                <a href="/" class="online-link">Go online</a> to save your progress permanently.
            </div>
        </div>
    </div>
</div>

<style>
.offline-menu-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.offline-header {
    text-align: center;
    margin-bottom: 40px;
}

.offline-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #ff6b6b, #ee5a52);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 20px;
}

.offline-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 10px;
}

.offline-subtitle {
    font-size: 1.2rem;
    color: #7f8c8d;
    margin-bottom: 0;
}

.practice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.practice-card {
    background: white;
    border-radius: 12px;
    padding: 30px 20px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
}

.practice-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    text-decoration: none;
    color: inherit;
}

.practice-card.addition {
    border-color: #3498db;
}

.practice-card.subtraction {
    border-color: #e74c3c;
}

.practice-card.multiplication {
    border-color: #f39c12;
}

.practice-card.addition-alt {
    border-color: #2ecc71;
}

.practice-card.addition-alt2 {
    border-color: #9b59b6;
}

.practice-card.addition-alt3 {
    border-color: #1abc9c;
}

.practice-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-size: 24px;
    color: white;
}

.addition .practice-icon {
    background: #3498db;
}

.subtraction .practice-icon {
    background: #e74c3c;
}

.multiplication .practice-icon {
    background: #f39c12;
}

.addition-alt .practice-icon {
    background: #2ecc71;
}

.addition-alt2 .practice-icon {
    background: #9b59b6;
}

.addition-alt3 .practice-icon {
    background: #1abc9c;
}

.practice-card h3 {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: #2c3e50;
}

.practice-card p {
    color: #7f8c8d;
    margin-bottom: 15px;
    line-height: 1.5;
}

.practice-badge {
    display: inline-block;
    background: #ecf0f1;
    color: #34495e;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 12px;
    font-weight: 500;
}

.offline-features {
    margin-bottom: 40px;
}

.offline-features h2 {
    text-align: center;
    font-size: 2rem;
    color: #2c3e50;
    margin-bottom: 30px;
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.feature-item {
    text-align: center;
    padding: 20px;
}

.feature-item i {
    font-size: 2rem;
    color: #3498db;
    margin-bottom: 15px;
}

.feature-item h4 {
    font-size: 1.2rem;
    color: #2c3e50;
    margin-bottom: 10px;
}

.feature-item p {
    color: #7f8c8d;
    line-height: 1.5;
}

.offline-notice {
    background: #fff3cd;
    border: 1px solid #ffeaa7;
    border-radius: 8px;
    padding: 15px;
    margin-top: 30px;
}

.notice-content {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #856404;
}

.notice-content i {
    color: #f39c12;
    margin-top: 2px;
}

.online-link {
    color: #3498db;
    text-decoration: none;
    font-weight: 500;
}

.online-link:hover {
    text-decoration: underline;
}

@@media (max-width: 768px) {
    .offline-title {
        font-size: 2rem;
    }
    
    .practice-grid {
        grid-template-columns: 1fr;
    }
    
    .features-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 480px) {
    .features-grid {
        grid-template-columns: 1fr;
    }
}
</style>
