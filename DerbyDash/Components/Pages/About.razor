@page "/about"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using DerbyDash.Services;
@inject NavigationManager NavManager
@inject ILogger<About> Logger
@inject DatabaseKeepAliveService DbKeepAlive
@attribute [AllowAnonymous]

<PageTitle>About TurboFlash</PageTitle>

<div class="about-container">
    <div class="about-header">
        <h1>@WelcomeMessage</h1>
    </div>

    <div class="about-content">
        <section class="about-section">
            <h2>How This Started</h2>
            <section class="about-sentence">
                <p>I was sitting with our daughter, going over her math homework, trying my best to be helpful.</p>
                <p>She’s a smart kid, but she didn’t feel that way.</p>
                <p>Arithmetic was tripping her up, and it was chipping away at her confidence.</p>
                <p>Then it hit me like a ton of bricks: what she really needed was a LOT more practice.</p>
                <p class="emphasis-break">Way more than a workbook could offer.</p>
                <p>We love the workbooks we use, but they clearly weren't enough.</p>
                <p>She’s an active girl, and the idea of sitting still for endless drills was a non-starter.</p>
                <p>I needed something that would keep her attention.</p>
                <p>Something that would make practice feel less like a chore and more like a game.</p>
            </section>
        </section>

        <section class="about-section">
            <p class="lead">
                Are you looking for a way to help your child build real math confidence – and actually enjoy the process?
            </p>
            <p>
                We know how important it is for kids to feel capable with math, and from working with our own kids, 
                we know how challenging traditional practice can be.
            </p>
            <p>
                That's why we created TurboFlash, a math game app designed to turn practice into play and help every student succeed.
            </p>
        </section>

        <section class="about-section">
            <h2>Why It Matters</h2>
            <p>Parents know that math confidence is foundational to success in school and later life.</p>
            <p>And they don't want their kids to struggle with math and get discouraged.</p>
            
            <h3>Many kids struggle with math facts because:</h3>
            <ul>
                <li>Traditional practice (like flashcards) is boring.</li>
                <li>Boredom creates lack of motivation and slows their progress.</li>
                <li>When they see other kids, who have memorized their math facts, getting answers quickly, they jump to the incorrect conclusion that they are "bad at math."</li>
                <li>Kids who feel "bad at math" miss out on the confidence that comes from improvement.</li>
            </ul>
        </section>

        <section class="about-section">
            <h2>The Negative Result</h2>
            <ul>
                <li>Their lack of confidence impacts almost every aspect of their life in school and career.</li>
                <li>Their math struggle today makes algebra, and everything after, harder than it needs to be.</li>
            </ul>
        </section>

        <section class="about-section highlight-section">
            <h2>TurboFlash Changes the Game</h2>
            <ul>
                <li>Turning practice into a fun, low-pressure race against their own best scores.</li>
                <li>Rewarding every bit of progress, so kids see quick wins.</li>
                <li>Helping all students – no matter their starting point – build confidence and enjoy learning math.</li>
                <li>Giving them a good foundation for success at algebra and at life.</li>
            </ul>
        </section>

        @if (!string.IsNullOrEmpty(Location)) {
            <section class="about-section conference-section">
                <h2>Visit Us at the @Location Home School Conference!</h2>
                <p>
                    Ready to see TurboFlash in action? We invite you to visit our booth at the @Location Home School Conference! 
                    Try the app for yourself, ask questions, and discover how TurboFlash can help your child develop 
                    the confidence and skills they need to thrive in math – and beyond. We look forward to meeting you!
                </p>
            </section>
        }
        <section class="about-section cta-section"> 
            <div>
            Note that TurboFlash is still in beta and we are actively working to improve the app.
            </div>
            <div>
                Any discounts or bonuses don't apply until it is released. 
            </div>
            <div>
                TurboFlash is free to play until then.
            </div>
        </section>

        <section class="about-section cta-section">
            <h2>Ready to Get Started?</h2>
            <p>Join thousands of families who are helping their children build math confidence through fun, engaging practice.</p>
            
            <div class="cta-buttons">
                <a href="/Identity/Account/Register" class="btn btn-primary btn-lg">Register <small>- Get Two Weeks Free!</small></a>
                <a href="/Identity/Account/Login" class="btn btn-outline-primary btn-lg">Sign In</a>
                <a href="/race" class="btn btn-success btn-lg">Start Racing</a>
            </div>
        </section>
        
        @if (ShowDebugInfo)
        {
            <div class="debug-info">
                <h4>Debug Information</h4>
                <p>Current Location Parameter: <strong>@(Location ?? "null")</strong></p>
                <p>Current Welcome Message: <strong>@WelcomeMessage</strong></p>
                <div class="alert alert-info">
                    <strong>Important:</strong> The URL format for location-specific pages is <code>/about?location=location</code>, not <code>/about/location</code>. 
                    This is because we're using query parameters, not route parameters.
                </div>
                <p>Try these links:</p>
                <div>
                    <a href="/about" class="btn btn-sm btn-outline-primary">Default About</a>
                    <a href="/about?location=iowa" class="btn btn-sm btn-outline-success">Iowa</a>
                    <a href="/about?location=arizona" class="btn btn-sm btn-outline-info">Arizona</a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string? Location { get; set; }

    // Set to true to show debug information, false for production
    private bool ShowDebugInfo = false;

    protected async override Task OnInitializedAsync() {
        // Parse query string parameters
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("location", out var locationParam)) {
            Location = locationParam.ToString();
        }
        
        // Log the location parameter for debugging
        Logger.LogInformation($"About page initialized with Location: {Location ?? "null"}");
        await DbKeepAlive.PingDatabaseAsync();
        await base.OnInitializedAsync();
    }

    private string WelcomeMessage => Location?.ToLower() switch {
        "iowa" => "Welcome, Iowa Home School Conference Attendees!",
        "arizona" => "Welcome, Arizona Home School Conference Attendees!",
        _ => "Welcome!"
    };
}