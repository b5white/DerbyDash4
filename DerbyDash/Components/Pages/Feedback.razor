@page "/feedback"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using DerbyDash.Services
@using DerbyDash.Data
@attribute [AllowAnonymous]
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject FeedbackService FeedbackService

<PageTitle>Feedback - TurboFlash</PageTitle>

<div class="feedback-container">
    <div class="feedback-header">
        <div class="race-flag left"></div>
        <h1>Pit Stop Feedback</h1>
        <div class="race-flag right"></div>
    </div>
    
    <div class="feedback-intro">
        <p>Help us tune up our race track! Report bugs or suggest improvements to make TurboFlash even better!</p>
    </div>

    <div class="feedback-content">
        @if (isSubmitted)
        {
            <div class="feedback-success">
                <div class="success-icon">✓</div>
                <h2>Thanks for your feedback!</h2>
                <p>Your report has been sent to our pit crew. We'll review it and make improvements to the race track!</p>
                <button class="btn-primary submit-button" @onclick="ResetForm">Submit Another Report</button>
            </div>
        }
        else
        {
            <EditForm Model="@feedbackModel" OnValidSubmit="HandleValidSubmit" FormName="FeedbackForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />
                
                <div class="form-section">
                    <div class="form-group">
                        <label for="name">Your Name</label>
                        <InputText id="name" @bind-Value="feedbackModel.Name" class="form-control" placeholder="Enter your name" />
                        <ValidationMessage For="@(() => feedbackModel.Name)" />
                    </div>
                    
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <InputText id="email" @bind-Value="feedbackModel.Email" class="form-control" placeholder="Enter your email" />
                        <ValidationMessage For="@(() => feedbackModel.Email)" />
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="feedbackType">Feedback Type</label>
                    <InputSelect @bind-Value="feedbackModel.FeedbackType" class="form-control">
                        <option value="">-- Select Feedback Type --</option>
                        @foreach (var type in Enum.GetValues(typeof(FeedbackType))) {
                            if ((FeedbackType)type != FeedbackType.None) {
                                <option value="@type">@type</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => feedbackModel.FeedbackType)" />
                </div>
                
                <div class="form-group">
                    <label for="subject">Subject</label>
                    <InputText id="subject" @bind-Value="feedbackModel.Subject" class="form-control" placeholder="Brief description of your feedback" />
                    <ValidationMessage For="@(() => feedbackModel.Subject)" />
                </div>
                
                <div class="form-group">
                    <label for="message">Message</label>
                    <InputTextArea id="message" @bind-Value="feedbackModel.Message" class="form-control" rows="6" placeholder="Please provide details about your feedback..." />
                    <ValidationMessage For="@(() => feedbackModel.Message)" />
                </div>
                
                <div class="form-group">
                    <label for="browser">Browser Information (Auto-detected)</label>
                    <InputText id="browser" @bind-Value="feedbackModel.BrowserInfo" class="form-control" readonly />
                </div>
                
                <div class="form-group checkbox-group">
                    <InputCheckbox id="contactConsent" @bind-Value="feedbackModel.ContactConsent" />
                    <label for="contactConsent">I agree to be contacted about this feedback if necessary</label>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn-secondary" @onclick="ResetForm">Clear Form</button>
                    <button type="submit" class="btn-primary submit-button">
                        <span class="checkered-flag">🏁</span> Submit Feedback
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

