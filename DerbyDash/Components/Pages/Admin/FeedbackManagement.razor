@page "/admin/feedback"
@layout AdminLayout
@* @attribute [Authorize(Roles = "Admin")] *@
@using DerbyDash.Data
@using DerbyDash.Services
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using DerbyDash.Components.Layout
@inject FeedbackService FeedbackService
@inject IUserService UserService
@inject IRaceTeamService RaceTeamService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Feedback Management - TurboFlash</PageTitle>

<div class="container mt-4">
    <h1>Feedback Management</h1>
    
    <!-- System Statistics -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">System Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 col-md-3">
                            <div class="d-flex flex-column">
                                <span class="fs-2 fw-bold text-primary">@totalUserCount</span>
                                <span class="text-muted">Total Users</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="d-flex flex-column">
                                <span class="fs-2 fw-bold text-success">@totalRacerCount</span>
                                <span class="text-muted">Total Racers</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="d-flex flex-column">
                                <span class="fs-2 fw-bold text-warning">@feedbackList.Count</span>
                                <span class="text-muted">Total Feedback</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="d-flex flex-column">
                                <span class="fs-2 fw-bold text-danger">@feedbackList.Count(f => !f.IsResolved)</span>
                                <span class="text-muted">Unresolved</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Filter Options</h5>
                    @if (selectedFeedbackType != null || !string.IsNullOrEmpty(selectedStatus)) {
                        <span class="badge bg-light text-dark">Filters Active</span>
                    }
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="form-group">
                                <label class="form-label">Filter by Type:</label>
                                <select class="form-select" @bind="selectedFeedbackType">
                                    <option value="">All Types</option>
                                    <option value="@FeedbackType.BugReport">Bug Report</option>
                                    <option value="@FeedbackType.FeatureRequest">Feature Request</option>
                                    <option value="@FeedbackType.GeneralFeedback">General Feedback</option>
                                    <option value="@FeedbackType.Question">Question</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="form-group">
                                <label class="form-label">Filter by Status:</label>
                                <select class="form-select" @bind="selectedStatus">
                                    <option value="">All Status</option>
                                    <option value="Resolved">Resolved</option>
                                    <option value="Unresolved">Unresolved</option>
                                </select>
                            </div>
                        </div>                        
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="form-group">
                                <label class="form-label">Start Date:</label>
                                <input type="date"
                                       class="form-control"
                                       @bind="selectedStartDate"
                                       @bind:format="yyyy-MM-dd" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="form-group">
                                <label class="form-label d-block">&nbsp;</label>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary flex-grow-1" @onclick="@(async () => await ApplyFilters())">
                                        <i class="bi bi-funnel"></i><span class="d-none d-sm-inline ms-1">Apply Filters</span>
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="@(async () => await ClearFilters())" 
                                            disabled="@(selectedFeedbackType == null && string.IsNullOrEmpty(selectedStatus))">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (feedbackList == null || !feedbackList.Any())
    {
        <div class="alert alert-info">
            No feedback submissions found.
        </div>
    }
    else
    {
        @if (selectedFeedbackType != null || !string.IsNullOrEmpty(selectedStatus)) {
            <div class="alert alert-info mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Active Filters:</strong>
                        @if (selectedFeedbackType != null) {
                            <span class="badge bg-primary ms-2">Type: @selectedFeedbackType</span>
                        }
                        @if (!string.IsNullOrEmpty(selectedStatus))
                        {
                            <span class="badge bg-primary ms-2">Status: @selectedStatus</span>
                        }
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="@(async () => await ClearFilters())">
                        <i class="bi bi-x-circle"></i> Clear Filters
                    </button>
                </div>
            </div>
        }
        
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Showing @feedbackList.Count feedback item(s)</h5>
        </div>
        
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th class="d-none d-md-table-cell">ID</th>
                        <th>Date</th>
                        <th>Name</th>
                        <th class="d-none d-md-table-cell">User ID</th>
                        <th class="d-none d-md-table-cell">Racer ID</th>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feedback in feedbackList)
                    {
                        <tr>
                            <td class="d-none d-md-table-cell">@feedback.Id</td>
                            <td>@feedback.SubmittedAt.ToString("MM/dd/yy", CultureInfo.InvariantCulture)</td>
                            <td>@feedback.Name</td>
                            <td class="d-none d-md-table-cell">
                                @if (!string.IsNullOrEmpty(feedback.UserId)) {
                                    <span class="badge bg-info text-truncate user-id-badge" title="@feedback.UserId">
                                        @(feedback.UserId.Length > 8 ? feedback.UserId.Substring(0, 8) + "..." : feedback.UserId)
                                    </span>
                                } else {
                                    <span class="badge bg-secondary">Anonymous</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (feedback.RacerId.HasValue) {
                                    <span class="badge bg-success"># @feedback.RacerId</span>
                                } else {
                                    <span class="badge bg-light text-dark">--</span>
                                }
                            </td>
                            <td>
                                <span class="d-none d-sm-inline">@feedback.FeedbackType</span>
                                <span class="d-inline d-sm-none">
                                    @switch (feedback.FeedbackType.ToString())
                                    {
                                        case "BugReport":
                                            <span title="Bug Report"><i class="bi bi-bug"></i></span>
                                            break;
                                        case "FeatureRequest":
                                            <span title="Feature Request"><i class="bi bi-lightbulb"></i></span>
                                            break;
                                        case "GeneralFeedback":
                                            <span title="General Feedback"><i class="bi bi-chat"></i></span>
                                            break;
                                        case "Question":
                                            <span title="Question"><i class="bi bi-question-circle"></i></span>
                                            break;
                                        default:
                                            <span>@feedback.FeedbackType</span>
                                            break;
                                    }
                                </span>
                            </td>
                            <td class="text-truncate subject-cell" title="@feedback.Subject">@feedback.Subject</td>
                            <td>
                                @if (feedback.IsResolved)
                                {
                                    <span class="badge bg-success">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Unresolved</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center flex-wrap gap-1">
                                    <a href="@($"/admin/feedback/{feedback.Id}")" class="btn btn-sm btn-info" title="View Details">
                                        <i class="bi bi-eye"></i><span class="d-none d-lg-inline ms-1">View</span>
                                    </a>
                                    @if (!feedback.IsResolved)
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="@(() => OpenResolveDialog(feedback))" title="Resolve Feedback">
                                            <i class="bi bi-check-circle"></i><span class="d-none d-lg-inline ms-1">Resolve</span>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-danger" @onclick="@(() => OpenDeleteDialog(feedback.Id))" title="Delete Feedback">
                                        <i class="bi bi-trash"></i><span class="d-none d-lg-inline ms-1">Delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Modal for resolving feedback -->
    @if (showResolveDialog)
    {
        <!-- Modal overlay with click handler to close -->
        <div class="modal-overlay" @onclick="@(() => CloseResolveDialog())"></div>
        
        <!-- Modal dialog -->
        <div class="modal-dialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h5 class="modal-title">Resolve Feedback</h5>
                    <button type="button" class="btn-close" @onclick="@(() => CloseResolveDialog())">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Public Response:</label>
                        <small class="text-muted d-block mb-2">Response visible to users when they view their feedback status</small>
                        <textarea class="form-control admin-notes-textarea" rows="4" @bind="publicResponse" placeholder="Enter public response that users can see...">
                        </textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Private Response:</label>
                        <small class="text-muted d-block mb-2">Internal notes for admin use only</small>
                        <textarea class="form-control admin-notes-textarea" rows="4" @bind="privateResponse" placeholder="Enter private notes for internal use...">
                        </textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Admin Notes (Legacy):</label>
                        <small class="text-muted d-block mb-2">Legacy field - use Public/Private Response fields above</small>
                        <textarea class="form-control admin-notes-textarea" rows="2" @bind="adminNotes" placeholder="Enter your resolution notes here...">
                        </textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary modal-button modal-button-secondary" @onclick="@(() => CloseResolveDialog())">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-success modal-button modal-button-success" @onclick="@(async () => await ResolveFeedback())">
                        Resolve
                    </button>
                </div>
            </div>
        </div>
    }
    
    <!-- Modal for deleting feedback -->
    @if (showDeleteDialog)
    {
        <!-- Modal overlay with click handler to close -->
        <div class="modal-overlay" @onclick="@(() => CloseDeleteDialog())"></div>
        
        <!-- Modal dialog -->
        <div class="modal-dialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Deletion</h5>
                    <button type="button" class="btn-close" @onclick="@(() => CloseDeleteDialog())">&times;</button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this feedback? This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary modal-button modal-button-secondary" @onclick="@(() => CloseDeleteDialog())">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger modal-button modal-button-danger" @onclick="@(async () => await ConfirmDeleteFeedback())">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    }


</div>

@code {
    private List<Feedback> feedbackList = new();
    private bool loading = true;
    private FeedbackType? selectedFeedbackType = null;
    private string selectedStatus = "";
    private bool showResolveDialog = false;
    private bool showDeleteDialog = false;
    private string adminNotes = "";
    private string publicResponse = "";
    private string privateResponse = "";
    private DateTime selectedStartDate = DateTime.UtcNow.AddMonths(-1);
    private int selectedFeedbackId;
    private int totalUserCount = 0;
    private int totalRacerCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadFeedback();
        await LoadSystemCounts();
    }

    private async Task LoadFeedback()
    {
        loading = true;
        feedbackList = await FeedbackService.GetFeedbackSinceDateAsync(selectedStartDate);
        loading = false;
    }

    private async Task LoadSystemCounts()
    {
        try
        {
            totalUserCount = await UserService.GetTotalUserCountAsync();
            totalRacerCount = await RaceTeamService.GetTotalRacerCountAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading system counts: {ex.Message}");
            totalUserCount = 0;
            totalRacerCount = 0;
        }
    }

    private async Task ApplyFilters()
    {
        try
        {
            Console.WriteLine($"ApplyFilters called - Type: '{selectedFeedbackType}', Status: '{selectedStatus}'");
            loading = true;
            
            // First get all feedback
            var allFeedback = await FeedbackService.GetFeedbackSinceDateAsync(selectedStartDate);
            Console.WriteLine($"Total feedback items: {allFeedback.Count}");
            
            // Apply type filter if selected
            if (selectedFeedbackType != null)
            {
                allFeedback = allFeedback.Where(f => f.FeedbackType == selectedFeedbackType).ToList();
                Console.WriteLine($"After type filter: {allFeedback.Count} items");
            }
            
            // Apply status filter if selected
            if (!string.IsNullOrEmpty(selectedStatus))
            {
                bool isResolved = selectedStatus == "Resolved";
                allFeedback = allFeedback.Where(f => f.IsResolved == isResolved).ToList();
                Console.WriteLine($"After status filter: {allFeedback.Count} items");
            }
            
            // Update the list
            feedbackList = allFeedback;
            Console.WriteLine("Filters applied successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error applying filters: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
        finally
        {
            loading = false;
            StateHasChanged(); // Ensure UI updates
        }
    }
    
    private async Task ClearFilters()
    {        
        selectedFeedbackType = null;
        selectedStatus = "";
        selectedStartDate = DateTime.UtcNow.AddMonths(-1);
        await LoadFeedback();
    }

    private void OpenResolveDialog(Feedback feedback)
    {
        selectedFeedbackId = feedback.Id;
        adminNotes = "";
        showResolveDialog = true;
        StateHasChanged(); // Ensure UI updates
    }

    private void CloseResolveDialog()
    {
        showResolveDialog = false;
        adminNotes = "";
        publicResponse = "";
        privateResponse = "";
        StateHasChanged(); // Ensure UI updates
    }

    private async Task ResolveFeedback()
    {
        try
        {
            Console.WriteLine($"Resolving feedback ID: {selectedFeedbackId} with notes: {adminNotes}, public: {publicResponse}, private: {privateResponse}");
            
            // First close the dialog to prevent UI issues
            showResolveDialog = false;
            StateHasChanged();
            
            // Then resolve the feedback
            bool result = await FeedbackService.ResolveFeedbackAsync(selectedFeedbackId, adminNotes, publicResponse, privateResponse);
            
            if (result)
            {
                Console.WriteLine("Feedback resolved successfully");
                await LoadFeedback();
            }
            else
            {
                Console.WriteLine("Failed to resolve feedback");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resolving feedback: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

    private void OpenDeleteDialog(int id)
    {
        selectedFeedbackId = id;
        showDeleteDialog = true;
        StateHasChanged(); // Ensure UI updates
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        StateHasChanged(); // Ensure UI updates
    }

    private async Task ConfirmDeleteFeedback()
    {
        try
        {
            Console.WriteLine($"Confirming deletion of feedback ID: {selectedFeedbackId}");
            
            // First close the dialog to prevent UI issues
            showDeleteDialog = false;
            StateHasChanged();
            
            // Then delete the feedback
            await DeleteFeedback(selectedFeedbackId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in confirm delete: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

    private async Task DeleteFeedback(int id)
    {
        try
        {
            Console.WriteLine($"Deleting feedback ID: {id}");
            
            if (await FeedbackService.DeleteFeedbackAsync(id))
            {
                Console.WriteLine("Feedback deleted successfully");
                await LoadFeedback();
            }
            else
            {
                Console.WriteLine("Failed to delete feedback");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting feedback: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }
}