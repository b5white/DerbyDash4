@page "/admin/feedback/{Id:int}"
@layout AdminLayout
@using System.Globalization
@using DerbyDash.Components.Layout
@inject FeedbackService FeedbackService
@inject IRaceTeamService RaceTeamService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>View Feedback - TurboFlash Admin</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h1 class="mb-0">Feedback Details</h1>
        <div class="d-flex flex-wrap gap-2">
            <a href="/admin/feedback" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i><span class="d-none d-sm-inline ms-1">Back to List</span>
            </a>
            @if (feedback != null) {
                <a href="@GetViewLogsUrl()" class="btn btn-outline-info">
                    <i class="bi bi-file-text"></i><span class="d-none d-sm-inline ms-1">View Logs</span>
                </a>
            }
            @if (feedback != null && !feedback.IsResolved) {
                <button class="btn btn-success" @onclick="OpenResolveDialog">
                    <i class="bi bi-check-circle"></i><span class="d-none d-sm-inline ms-1">Resolve</span>
                </button>
            }
            @if (feedback != null && feedback.IsResolved) {
                <button class="btn btn-outline-success" @onclick="OpenResolveDialog">
                    <i class="bi bi-pencil"></i><span class="d-none d-sm-inline ms-1">Edit Resolution</span>
                </button>
            }
        </div>
    </div>

    @if (loading) {
        <div class="text-center p-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    } else if (feedback == null) {
        <div class="alert alert-danger">
            <h4 class="alert-heading">Feedback Not Found</h4>
            <p>The feedback item you're looking for doesn't exist or has been deleted.</p>
            <hr>
            <p class="mb-0">
                <a href="/admin/feedback" class="btn btn-outline-danger">
                    <i class="bi bi-arrow-left"></i> Back to Feedback List
                </a>
            </p>
        </div>
    } else {
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-chat-text me-2"></i>
                            @feedback.Subject
                        </h5>
                        <span class="badge @(feedback.IsResolved ? "bg-success" : "bg-warning")">
                            @(feedback.IsResolved ? "Resolved" : "Unresolved")
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="feedback-message p-3 bg-light rounded mb-4">
                            <p class="mb-0" style="white-space: pre-wrap;">@feedback.Message</p>
                        </div>

                        @if (feedback.IsResolved && !string.IsNullOrEmpty(feedback.AdminNotes)) {
                            <div class="admin-response mt-4">
                                <h6 class="text-success mb-2">
                                    <i class="bi bi-check-circle me-1"></i> Admin Response
                                </h6>
                                <div class="p-3 bg-success bg-opacity-10 border border-success rounded">
                                    <p class="mb-0" style="white-space: pre-wrap;">@feedback.AdminNotes</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">
                                Submitted on @feedback.SubmittedAt.ToString("MMM dd, yyyy HH:mm", CultureInfo.InvariantCulture)
                            </small>
                            @if (feedback.IsResolved && feedback.ResolvedAt.HasValue) {
                                <small class="text-success">
                                    Resolved on @feedback.ResolvedAt.Value.ToString("MMM dd, yyyy HH:mm", CultureInfo.InvariantCulture)
                                </small>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 mt-4">
                    <a href="/admin/feedback" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i><span class="d-none d-sm-inline ms-1">Back to List</span>
                    </a>
                    <div class="d-flex flex-wrap gap-2">
                        @if (feedback != null) {
                            <a href="@GetViewLogsUrl()" class="btn btn-outline-info">
                                <i class="bi bi-file-text"></i><span class="d-none d-sm-inline ms-1">View Logs</span>
                            </a>
                        }
                        @if (feedback != null && !feedback.IsResolved) {
                            <button class="btn btn-success" @onclick="OpenResolveDialog">
                                <i class="bi bi-check-circle"></i><span class="d-none d-sm-inline ms-1">Resolve</span>
                            </button>
                        }
                        @if (feedback != null && feedback.IsResolved) {
                            <button class="btn btn-outline-success" @onclick="OpenResolveDialog">
                                <i class="bi bi-pencil"></i><span class="d-none d-sm-inline ms-1">Edit Resolution</span>
                            </button>
                        }
                        <button class="btn btn-danger" @onclick="DeleteFeedback">
                            <i class="bi bi-trash"></i><span class="d-none d-sm-inline ms-1">Delete</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-person me-2"></i>
                            Submitter Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong>Name:</strong></span>
                                <span>@feedback?.Name</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong>Email:</strong></span>
                                <span>
                                    <a href="mailto:@feedback.Email">@feedback.Email</a>
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong>Contact Consent:</strong></span>
                                <span>
                                    @if (feedback.ContactConsent) {
                                        <span class="badge bg-success">Yes</span>
                                    } else {
                                        <span class="badge bg-danger">No</span>
                                    }
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong>Feedback Type:</strong></span>
                                <span>@feedback.FeedbackType</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <span><strong>User Account:</strong></span>
                                <div class="text-end">
                                    @if (!string.IsNullOrEmpty(feedback.UserId)) {
                                        <div>
                                            @if (!string.IsNullOrEmpty(userDisplayName)) {
                                                <div>@userDisplayName</div>
                                                <small class="text-muted">ID: @feedback.UserId</small>
                                            } else {
                                                <div>@feedback.UserId</div>
                                            }
                                        </div>
                                    } else {
                                        <span class="badge bg-warning">Anonymous</span>
                                    }
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <span><strong>Racer:</strong></span>
                                <div class="text-end">
                                    @if (feedback.RacerId.HasValue) {
                                        <div>
                                            @if (!string.IsNullOrEmpty(racerDisplayName)) {
                                                <div>@racerDisplayName</div>
                                                <small class="text-muted">ID: @feedback.RacerId</small>
                                            } else {
                                                <div>Racer ID: @feedback.RacerId</div>
                                            }
                                        </div>
                                    } else {
                                        <span class="badge bg-secondary">No Racer</span>
                                    }
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Technical Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong>ID:</strong></span>
                                <span>@feedback.Id</span>
                            </li>
                            <li class="list-group-item">
                                <div>
                                    <strong>Browser Info:</strong>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">@feedback.BrowserInfo</small>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showResolveDialog) {
        <div class="modal fade show" style="display: block;" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Resolve Feedback</h5>
                        <button type="button" class="btn-close" @onclick="CloseResolveDialog"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Admin Notes:</label>
                            <textarea class="form-control" rows="4" @bind="adminNotes" placeholder="Enter your resolution notes here..."></textarea>
                            @if (!string.IsNullOrEmpty(errorMessage)) {
                                <div class="alert alert-danger">@errorMessage</div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseResolveDialog">Cancel</button>
                        <button type="button" class="btn btn-success" @onclick="ResolveFeedback" disabled="@isResolving">
                            @if (isResolving) {
                                <span class="spinner-border spinner-border-sm me-1">Resolving...</span>
                            } else {
                                <span>Resolve</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showResolveDialog) {
        <div class="modal-backdrop fade show"></div>
    }

    @if (showDeleteConfirmation) {
        <div class="modal fade show" style="display: block;" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Deletion</h5>
                        <button type="button" class="btn-close" @onclick="() => showDeleteConfirmation = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <p>Are you sure you want to delete this feedback? This action cannot be undone.</p>
                            @if (!string.IsNullOrEmpty(errorMessage)) {
                                <div class="alert alert-danger">@errorMessage</div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => showDeleteConfirmation = false">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showDeleteConfirmation) {
        <div class="modal-backdrop fade show"></div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Feedback? feedback;
    private bool loading = true;
    private bool showResolveDialog = false;
    private bool showDeleteConfirmation = false;
    private string adminNotes = "";
    private string? errorMessage = "";
    private bool isResolving = false;
    
    // Additional properties for user and racer information
    private string? userDisplayName;
    private string? racerDisplayName;

    // enable handling the escape key to close
    private DotNetObjectReference<ViewFeedback>? _objectRef;
    private IJSObjectReference? _jsEscapeHelper;

    protected override async Task OnInitializedAsync() {
        await LoadFeedback();
    }

    protected override async Task OnParametersSetAsync() {
        await LoadFeedback();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (showResolveDialog && _objectRef == null) {
            _objectRef = DotNetObjectReference.Create(this);
            _jsEscapeHelper = await JS.InvokeAsync<IJSObjectReference>("registerEscapeKey", _objectRef);
        } else if (!showResolveDialog && _objectRef != null) {
            _objectRef.Dispose();
            _objectRef = null;
            if (_jsEscapeHelper != null) {
                await _jsEscapeHelper.InvokeVoidAsync("dispose");
                await _jsEscapeHelper.DisposeAsync();
                _jsEscapeHelper = null;
            }
        }
    }

    [JSInvokable]
    public void OnEscape() {
        if (showResolveDialog)
            CloseResolveDialog();
    }

    private async Task LoadFeedback() {
        loading = true;
        feedback = await FeedbackService.GetFeedbackByIdAsync(Id);
        
        // Load additional user and racer information
        await LoadAdditionalUserInfo();
        
        loading = false;
    }
    
    private async Task LoadAdditionalUserInfo() {
        userDisplayName = null;
        racerDisplayName = null;
        
        if (feedback != null) {
            // Load user information if UserId is available
            if (!string.IsNullOrEmpty(feedback.UserId)) {
                try {
                    var user = await UserManager.FindByIdAsync(feedback.UserId);
                    if (user != null) {
                        userDisplayName = !string.IsNullOrEmpty(user.UserName) ? user.UserName : user.Email;
                    }
                } catch (Exception ex) {
                    // If we can't load user info, just log and continue
                    Console.WriteLine($"Could not load user info for ID {feedback.UserId}: {ex.Message}");
                }
            }
            
            // Load racer information if RacerId is available
            if (feedback.RacerId.HasValue) {
                try {
                    var racer = await RaceTeamService.GetRacerByIdAsync(feedback.RacerId.Value);
                    if (racer != null) {
                        racerDisplayName = racer.Name;
                    }
                } catch (Exception ex) {
                    // If we can't load racer info, just log and continue
                    Console.WriteLine($"Could not load racer info for ID {feedback.RacerId}: {ex.Message}");
                }
            }
        }
    }

    private void OpenResolveDialog() {
        adminNotes = feedback?.AdminNotes ?? "";
        showResolveDialog = true;
    }

    private void CloseResolveDialog() {
        showResolveDialog = false;
        errorMessage = "";
    }


    private async Task ResolveFeedback() {
        if (isResolving)
            return;
        isResolving = true;
        try {
            if (await FeedbackService.ResolveFeedbackAsync(Id, adminNotes)) {
                showResolveDialog = false;
                await LoadFeedback();
            } else {
                errorMessage = "Failed to resolve feedback. Please try again.";
            }

        } finally {
            isResolving = false;
        }
    }

    private void DeleteFeedback() {
        showDeleteConfirmation = true;
    }

    private async Task ConfirmDelete() {
        if (await FeedbackService.DeleteFeedbackAsync(Id)) {
            showDeleteConfirmation = false;
            NavigationManager.NavigateTo("/admin/feedback");
        } else {
            errorMessage = "Failed to delete feedback. It may have already been deleted.";
        }
    }

    private string GetViewLogsUrl() {
        if (feedback == null) return "/admin/logs";
        
        var parameters = new List<string>();
        
        // Add from date parameter (feedback submission time)
        parameters.Add($"FromDate={feedback.SubmittedAt:yyyy-MM-ddTHH:mm:ss}");
        
        // Add user ID if available
        if (!string.IsNullOrEmpty(feedback.UserId)) {
            parameters.Add($"UserId={Uri.EscapeDataString(feedback.UserId)}");
        }
        
        // Add racer ID if available
        if (feedback.RacerId.HasValue) {
            parameters.Add($"RacerId={feedback.RacerId.Value}");
        }
        
        // Note: SessionId could be added here if it's available in the feedback context
        // For now, we'll focus on filtering by user and racer, which are more relevant
        
        var queryString = string.Join("&", parameters);
        return $"/admin/logs?{queryString}";
    }
}