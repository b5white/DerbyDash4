@page "/admin/logs"
@layout AdminLayout
@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using DerbyDash.Data
@using DerbyDash.Services
@using DerbyDash.Components.Layout
@inject ILogService LogService
@inject IRaceTeamService RaceTeamService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>View Logs - TurboFlash Admin</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h1 class="mb-0">System Logs</h1>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary" @onclick="ToggleFilters">
                <i class="bi bi-funnel"></i><span class="d-none d-sm-inline ms-1">Filters</span>
            </button>
            <button class="btn btn-outline-secondary" @onclick="RefreshLogs">
                <i class="bi bi-arrow-clockwise"></i><span class="d-none d-sm-inline ms-1">Refresh</span>
            </button>
        </div>
    </div>

    @if (showFilters)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter Options</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">From Date</label>
                        <input type="datetime-local" class="form-control" @bind="filterFromDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">User ID</label>
                        <input type="text" class="form-control" @bind="filterUserId" placeholder="Enter User ID" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Racer ID</label>
                        <input type="number" class="form-control" @bind="filterRacerId" placeholder="Enter Racer ID" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Session ID</label>
                        <input type="text" class="form-control" @bind="filterSessionId" placeholder="Enter Session ID" />
                    </div>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-md-3">
                        <label class="form-label">Log Level</label>
                        <select class="form-control" @bind="filterLogLevel">
                            <option value="">All Levels</option>
                            <option value="0">Trace</option>
                            <option value="1">Debug</option>
                            <option value="2">Information</option>
                            <option value="3">Warning</option>
                            <option value="4">Error</option>
                            <option value="5">Critical</option>
                        </select>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" @onclick="ApplyFilters">
                                <i class="bi bi-search"></i> Apply Filters
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                                <i class="bi bi-x-circle"></i> Clear
                            </button>
                            <button class="btn btn-outline-warning" @onclick="ShowExceptionsOnly">
                                <i class="bi bi-exclamation-triangle"></i> Exceptions Only
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (loading)
    {
        <div class="text-center p-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (logs == null || !logs.Any())
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No Logs Found</h4>
            <p>No logs match the current filter criteria.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    Log Entries (@logs.Count)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Timestamp</th>
                                <th>Level</th>
                                <th>Category</th>
                                <th>Message</th>
                                <th>User/Racer</th>
                                <th>Session</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in logs)
                            {
                                <tr class="@GetLogRowClass(log.LogLevel)">
                                    <td>
                                        <small class="text-muted">
                                            @log.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss", CultureInfo.InvariantCulture)
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge @GetLogLevelBadgeClass(log.LogLevel)">
                                            @GetLogLevelName(log.LogLevel)
                                        </span>
                                    </td>
                                    <td>
                                        <small>@log.Category</small>
                                    </td>
                                    <td>
                                        <div class="log-message">
                                            @if (!string.IsNullOrEmpty(log.EventName))
                                            {
                                                <strong>@log.EventName:</strong>
                                            }
                                            @(string.IsNullOrEmpty(log.Message) ? "No message" : (log.Message.Length > 100 ? log.Message.Substring(0, 100) + "..." : log.Message))
                                        </div>
                                        @if (!string.IsNullOrEmpty(log.ExceptionMessage))
                                        {
                                            <div class="text-danger small mt-1">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                @(log.ExceptionMessage.Length > 50 ? log.ExceptionMessage.Substring(0, 50) + "..." : log.ExceptionMessage)
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.UserId))
                                        {
                                            <div class="small">
                                                <i class="bi bi-person me-1"></i>
                                                @log.UserId.Substring(0, Math.Min(8, log.UserId.Length))...
                                            </div>
                                        }
                                        @if (log.RacerId.HasValue)
                                        {
                                            <div class="small">
                                                <i class="bi bi-trophy me-1"></i>
                                                Racer @log.RacerId
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.SessionId))
                                        {
                                            <div class="small text-muted">
                                                <i class="bi bi-clock me-1"></i>
                                                @log.SessionId.Substring(0, Math.Min(8, log.SessionId.Length))...
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary btn-sm" 
                                                    @onclick="() => ViewLogDetails(log)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (selectedLog != null && showLogDetails)
{
    <div class="modal fade show modal-show" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-file-text me-2"></i>
                        Log Details - @GetLogLevelName(selectedLog.LogLevel)
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseLogDetails"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <strong>ID:</strong> @selectedLog.Id
                        </div>
                        <div class="col-md-6">
                            <strong>Timestamp:</strong> @selectedLog.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss.fff", CultureInfo.InvariantCulture)
                        </div>
                        <div class="col-md-6">
                            <strong>Level:</strong> 
                            <span class="badge @GetLogLevelBadgeClass(selectedLog.LogLevel)">
                                @GetLogLevelName(selectedLog.LogLevel)
                            </span>
                        </div>
                        <div class="col-md-6">
                            <strong>Category:</strong> @selectedLog.Category
                        </div>
                        @if (!string.IsNullOrEmpty(selectedLog.EventName))
                        {
                            <div class="col-md-6">
                                <strong>Event Name:</strong> @selectedLog.EventName
                            </div>
                        }
                        @if (selectedLog.EventId.HasValue)
                        {
                            <div class="col-md-6">
                                <strong>Event ID:</strong> @selectedLog.EventId
                            </div>
                        }
                        @if (selectedLog.ThreadId.HasValue)
                        {
                            <div class="col-md-6">
                                <strong>Thread ID:</strong> @selectedLog.ThreadId
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(selectedLog.UserId))
                        {
                            <div class="col-md-6">
                                <strong>User ID:</strong> @selectedLog.UserId
                            </div>
                        }
                        @if (selectedLog.RacerId.HasValue)
                        {
                            <div class="col-md-6">
                                <strong>Racer ID:</strong> @selectedLog.RacerId
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(selectedLog.SessionId))
                        {
                            <div class="col-md-6">
                                <strong>Session ID:</strong> @selectedLog.SessionId
                            </div>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(selectedLog.Message))
                    {
                        <div class="mt-3">
                            <strong>Message:</strong>
                            <div class="p-3 bg-light rounded mt-2">
                                <pre class="log-details-pre">@selectedLog.Message</pre>
                            </div>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(selectedLog.ExceptionMessage))
                    {
                        <div class="mt-3">
                            <strong class="text-danger">Exception Message:</strong>
                            <div class="p-3 bg-danger bg-opacity-10 border border-danger rounded mt-2">
                                <pre class="log-exception-pre">@selectedLog.ExceptionMessage</pre>
                            </div>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(selectedLog.ExceptionSource))
                    {
                        <div class="mt-3">
                            <strong class="text-danger">Exception Source:</strong>
                            <div class="p-2 bg-danger bg-opacity-10 border border-danger rounded mt-2">
                                @selectedLog.ExceptionSource
                            </div>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(selectedLog.ExceptionStackTrace))
                    {
                        <div class="mt-3">
                            <strong class="text-danger">Stack Trace:</strong>
                            <div class="p-3 bg-danger bg-opacity-10 border border-danger rounded mt-2 exception-stack-container">
                                <pre class="exception-stack-pre">@selectedLog.ExceptionStackTrace</pre>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseLogDetails">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? UserId { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public int? RacerId { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public DateTime? FromDate { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public string? SessionId { get; set; }

    private List<Log>? logs;
    private bool loading = true;
    private bool showFilters = false;
    private bool showLogDetails = false;
    private Log? selectedLog;

    // Filter parameters
    private DateTime? filterFromDate;
    private string? filterUserId;
    private int? filterRacerId;
    private string? filterSessionId;
    private string? filterLogLevel;

    protected override async Task OnInitializedAsync()
    {
        // Set initial filter values from query parameters
        filterFromDate = FromDate;
        filterUserId = UserId;
        filterRacerId = RacerId;
        filterSessionId = SessionId;

        await LoadLogs();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Update filters when parameters change
        filterFromDate = FromDate;
        filterUserId = UserId;
        filterRacerId = RacerId;
        filterSessionId = SessionId;
        
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        loading = true;
        
        int? logLevelFilter = null;
        if (!string.IsNullOrEmpty(filterLogLevel) && int.TryParse(filterLogLevel, out int level))
        {
            logLevelFilter = level;
        }

        logs = await LogService.GetLogsAsync(
            fromDate: filterFromDate,
            userId: filterUserId,
            racerId: filterRacerId,
            logLevel: logLevelFilter,
            sessionId: filterSessionId,
            limit: 100
        );
        
        loading = false;
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private async Task RefreshLogs()
    {
        await LoadLogs();
    }

    private async Task ApplyFilters()
    {
        await LoadLogs();
        showFilters = false;
    }

    private async Task ClearFilters()
    {
        filterFromDate = null;
        filterUserId = null;
        filterRacerId = null;
        filterSessionId = null;
        filterLogLevel = null;
        await LoadLogs();
    }

    private async Task ShowExceptionsOnly()
    {
        filterLogLevel = "4"; // Error level and above
        logs = await LogService.GetExceptionLogsAsync(filterFromDate, 100);
        loading = false;
        showFilters = false;
    }

    private void ViewLogDetails(Log log)
    {
        selectedLog = log;
        showLogDetails = true;
    }

    private void CloseLogDetails()
    {
        selectedLog = null;
        showLogDetails = false;
    }

    private string GetLogRowClass(int logLevel)
    {
        return logLevel switch
        {
            4 => "table-danger", // Error
            5 => "table-danger", // Critical
            3 => "table-warning", // Warning
            _ => ""
        };
    }

    private string GetLogLevelBadgeClass(int logLevel)
    {
        return logLevel switch
        {
            0 => "bg-secondary", // Trace
            1 => "bg-info", // Debug
            2 => "bg-primary", // Information
            3 => "bg-warning", // Warning
            4 => "bg-danger", // Error
            5 => "bg-dark", // Critical
            _ => "bg-secondary"
        };
    }

    private string GetLogLevelName(int logLevel)
    {
        return logLevel switch
        {
            0 => "Trace",
            1 => "Debug",
            2 => "Info",
            3 => "Warning",
            4 => "Error",
            5 => "Critical",
            _ => "Unknown"
        };
    }
}