@page "/subscription"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using DerbyDash.Services
@using DerbyDash.Data
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject ISubscriptionService SubscriptionService
@inject ILogger<Subscription> Logger
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Subscription - TurboFlash</PageTitle>

<div class="subscription-container">
    <div class="subscription-header">
        <div class="race-flag left"></div>
        <h1>Subscription Overview</h1>
        <div class="race-flag right"></div>
    </div>

    @if (isLoading) {
        <div class="loading-container">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading subscription data...</p>
        </div>
    } else if (userSubscription == null) {
        <div class="alert alert-warning" role="alert">
            No subscription found. Please contact support.
        </div>
    } else {
        <div class="subscription-content">
            <div class="subscription-card">
                <div class="subscription-section current-plan">
                    <p class="section-title">Current Subscription (@userSubscription.Type.ToString())</p>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @(userSubscription.ProgressPercentage)%"></div>
                    </div>
                    <p class="section-info">
                        @if (userSubscription.IsPaused) {
                            <span class="paused-badge">PAUSED</span>
                        } else if (userSubscription.Status == SubscriptionStatus.Cancelled) {
                            <span class="cancelled-badge">CANCELLED</span>
                        } else {
                            @userSubscription.DaysRemaining <text> days left</text> @(userSubscription.IsTrial ? " on trial" : "")
                        }
                    </p>
                </div>

                <div class="subscription-section auto-renewal">
                    <p class="section-title">Auto-renewal is @(userSubscription.AutoRenewal ? "on" : "off")</p>
                    <button class="action-button" @onclick="ToggleAutoRenewal" disabled="@(userSubscription.Status == SubscriptionStatus.Cancelled)">
                        @(userSubscription.AutoRenewal ? "Turn Off" : "Turn On")
                    </button>
                </div>

                <div class="subscription-section referral-credits">
                    <div class="credits-display">
                        <span class="credits-count">@userSubscription.ReferralCredits</span>
                        <span class="credits-label">Referral Credits</span>
                    </div>
                    <div class="credits-action">
                        <button class="action-button" @onclick="UseReferralCredit" disabled="@(userSubscription.ReferralCredits <= 0)">
                            Pay It Forward
                        </button>
                    </div>
                </div>

                <div class="subscription-section upgrade">
                    <div class="section-info-block">
                        <p class="section-title">Upgrade / Renew</p>
                        <p class="section-description">Use your credits when you renew<br>your subscription.</p>
                    </div>
                    <button class="action-button" @onclick="ToggleRenewOptions">
                        @(showRenewOptions ? "Hide Options" : "Renew")
                    </button>
                </div>

                @if (showRenewOptions) {
                    <div class="subscription-section renew-options">
                        <div class="renew-option-buttons">
                            <button class="renew-option-button @(selectedRenewalType == SubscriptionType.Monthly ? "selected" : "")"
                                    @onclick="() => SelectRenewalType(SubscriptionType.Monthly)">
                                Monthly
                            </button>
                            <button class="renew-option-button @(selectedRenewalType == SubscriptionType.Annual ? "selected" : "")"
                                    @onclick="() => SelectRenewalType(SubscriptionType.Annual)">
                                Annual
                            </button>
                            <button class="renew-option-button @(selectedRenewalType == SubscriptionType.Lifetime ? "selected" : "")"
                                    @onclick="() => SelectRenewalType(SubscriptionType.Lifetime)">
                                Lifetime
                            </button>
                        </div>
                        <button class="action-button confirm-button" @onclick="RenewSubscription">
                            Confirm Renewal
                        </button>
                    </div>
                }

                <div class="subscription-section pause">
                    <div class="section-info-block">
                        <p class="section-title">@(userSubscription.IsPaused ? "Resume" : "Pause") Subscription</p>
                        <p class="section-description">
                            @if (userSubscription.IsPaused) {
                                <span>Your subscription is currently paused.<br>Resume to continue using premium features.</span>
                            } else {
                                <span>Temporarily pause your subscription.<br>You can restart whenever convenient for you.</span>
                            }
                        </p>
                    </div>
                    <button class="action-button" @onclick="TogglePauseSubscription" disabled="@(userSubscription.Status == SubscriptionStatus.Cancelled)">
                        @(userSubscription.IsPaused ? "Resume" : "Pause")
                    </button>
                </div>

                <div class="subscription-section cancel">
                    <div class="section-info-block">
                        <p class="section-title">Cancel Subscription</p>
                        <p class="section-description">You can cancel your subscription<br>at any time. It will not auto-renew.</p>
                    </div>
                    <button class="action-button" @onclick="CancelSubscription" disabled="@(userSubscription.Status == SubscriptionStatus.Cancelled)">
                        @(userSubscription.Status == SubscriptionStatus.Cancelled ? "Cancelled" : "Cancel")
                    </button>
                </div>

                <div class="subscription-section special-offers">
                    <p class="section-title">Special Offers</p>
                    <div class="offers-progress-bar">
                        <div class="offers-progress-fill" style="width: @(userSubscription.SpecialOffersProgress)%"></div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(errorMessage)) {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                <div class="subscription-footer">
                    <a href="#" class="footer-link">Special Offers</a>
                    <a href="#" class="footer-link">Payment Details</a>
                    <a href="/faq" class="footer-link">FAQ</a>
                    <a href="#" class="footer-link">Contact Support</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Data.Subscription userSubscription = new Data.Subscription() { UserId = "none" };
    private bool isLoading = true;
    private bool showRenewOptions = false;
    private SubscriptionType selectedRenewalType = SubscriptionType.Monthly;
    private string userId = "demo-user"; // TODO Get this from user service
    private string? errorMessage;    protected override async Task OnInitializedAsync() {
        // Check if user is authenticated and redirect to manage page
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true) {
            Navigation.NavigateTo("/Account/Manage/Subscription", replace: true);
            return;
        }

        try {
            userSubscription = await SubscriptionService.GetCurrentSubscriptionAsync(userId);
            if (userSubscription == null) {
                errorMessage = "There was an error loading your subscription. Please try again later.";
                Logger.LogError("Error loading subscription");
            }
        } finally {
            isLoading = false;
        }
    }

    private void ToggleRenewOptions() {
        showRenewOptions = !showRenewOptions;
    }

    private void SelectRenewalType(SubscriptionType type) {
        selectedRenewalType = type;
    }

    private async Task ToggleAutoRenewal() {
        if (userSubscription != null) {
            if (await SubscriptionService.ToggleAutoRenewalAsync(userId)) {
                errorMessage = null; // Clear any previous error
            } else {
                errorMessage = "Failed to toggle auto-renewal. Please try again.";
            }
        }
    }

    private async Task TogglePauseSubscription() {
        bool result = true;
        if (userSubscription.IsPaused) {
            result = await SubscriptionService.ResumeSubscriptionAsync(userId);
        } else {
            result = await SubscriptionService.PauseSubscriptionAsync(userId);
        }
        if (result) {
            errorMessage = null; // Clear any previous error
        } else {
            errorMessage = "Failed to toggle pausing your subscription. Please try again.";
        }
    }

    private async Task CancelSubscription() {
        if (userSubscription.Status != SubscriptionStatus.Cancelled) {
            if (await SubscriptionService.CancelSubscriptionAsync(userId) ) {
                errorMessage = null; // Clear any previous error
            } else {
                errorMessage = "Failed to cancel your subscription. Please try again.";
            }
        }
    }

    private async Task RenewSubscription() {
        if (await SubscriptionService.RenewSubscriptionAsync(userId, selectedRenewalType)) {
            showRenewOptions = false;
            errorMessage = null; // Clear any previous error
        } else {
            errorMessage = "Failed to Renew Subscription. Please try again.";
        }
    }

    private async Task UseReferralCredit() {
        if (userSubscription.ReferralCredits > 0) {
            if (await SubscriptionService.UseReferralCreditAsync(userId)) {
                errorMessage = null; // Clear any previous error
            } else {
                errorMessage = "Failed to update renewal credits. Please try again.";
            }
        }
    }
}