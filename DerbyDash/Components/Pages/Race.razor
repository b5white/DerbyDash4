@page "/race/{ProblemClassString}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using DerbyDash.Components.Problems
@using DerbyDash.Components.Layout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization

@if (!Started) {
    <div class="race-start-container">
        <div class="race-title-box">
            <h1 class="race-title">@GetTitle(ProblemClassString)</h1>
            <p class="race-subtitle">Ready to race with numbers?</p>
        </div>

        @* Large Racer Avatar Display *@
        <AuthorizeView Context="authContext">
            <Authorized>
                @if (_cachedActiveRacer != null)
                {
                    <div class="current-racer-display">
                        <div class="racer-avatar-container">
                            @if (!string.IsNullOrEmpty(_cachedActiveRacer.AvatarFileName))
                            {
                                <img src="/images/avatars/@_cachedActiveRacer.AvatarFileName" 
                                     class="large-racer-avatar" 
                                     alt="@_cachedActiveRacer.Name's Avatar" />
                            }
                            else
                            {
                                <div class="large-racer-avatar-default">
                                    @(_cachedActiveRacer.Name.Substring(0, 1).ToUpper())
                                </div>
                            }
                        </div>
                        <div class="racer-info">
                            <h2 class="racer-name">@_cachedActiveRacer.Name</h2>
                            <p class="racer-subtitle">is ready to race!</p>
                        </div>
                    </div>
                }
            </Authorized>
            <NotAuthorized>
                <div class="guest-racer-display">
                    <div class="racer-avatar-container">
                        <div class="large-racer-avatar-default">
                            <i class="fas fa-user-astronaut"></i>
                        </div>
                    </div>
                    <div class="racer-info">
                        <h2 class="racer-name">Guest Racer</h2>
                        <p class="racer-subtitle">Login to save your progress!</p>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView Context="authContext">
            <Authorized>
                <EditForm EditContext="@editContext" OnValidSubmit="@(async () => await StartClick())" FormName="StartRaceForm">
                    <input type="text" id="hidden" style="position:absolute; left:-9999px;" tabindex="0" />
                    <button type="submit" tabindex="1" id="startButton" class="race-start-button" autofocus>
                        <div class="button-content">
                            <i class="fas fa-flag-checkered"></i>
                            <span>Start Race</span>
                        </div>
                    </button>
                </EditForm>
            </Authorized>
            <NotAuthorized>
                <div class="login-required-message">
                    <div class="race-login-card">
                        <div class="race-login-icon">
                            <i class="fas fa-lock"></i>
                        </div>
                        <h3>Login Required</h3>
                        <p>You need to be logged in to start this race and save your progress!</p>
                        <div class="race-login-benefits">
                            <div class="benefit-item">
                                <i class="fas fa-trophy"></i>
                                <span>Track your best times</span>
                            </div>
                            <div class="benefit-item">
                                <i class="fas fa-chart-line"></i>
                                <span>See your progress</span>
                            </div>
                            <div class="benefit-item">
                                <i class="fas fa-medal"></i>
                                <span>Compete on leaderboards</span>
                            </div>
                        </div>
                        <div class="race-login-buttons">
                            <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(NavManager.Uri)" class="btn btn-primary btn-race-login">
                                <i class="fas fa-sign-in-alt"></i> Log In
                            </a>
                            <a href="/Account/Register" class="btn btn-secondary btn-race-register">
                                <i class="fas fa-user-plus"></i> Register
                            </a>
                        </div>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <div class="race-instructions">
            <p>Solve math problems to accelerate your car.</p>
            <p>Then, beat the other cars to win the race!</p>
        </div>
    </div>
} else if (Finished) {
    @if (ReceivedError) {
        <div class="error-container">
            <div class="error-message">
                <i class="fas fa-exclamation-circle"></i>
                <p>The system ran into a problem and couldn't calculate your results.</p>
            </div>
            <EditForm EditContext="@editContext" OnValidSubmit="@(async () => await StartClick())">
                <button class="retry-button" type="submit" tabindex="0" autofocus="autofocus">
                    <i class="fas fa-redo"></i> Try again
                </button>
                <input type="text" id="hidden" />
            </EditForm>
        </div>
    } else {
        <div class="results-box">
        </div>
        <div class="results-container">
            <div class="results-header">
                <h1 class="race-title">@GetTitle(ProblemClassString)</h1>
                <h2 class="encouraging-message">@encouragingWord</h2>
                
                @* Medium Racer Avatar Display *@
                <AuthorizeView Context="authContext">
                    <Authorized>
                        @if (_cachedActiveRacer != null)
                        {
                            <div class="results-racer-display">
                                <div class="results-racer-avatar-container">
                                    @if (!string.IsNullOrEmpty(_cachedActiveRacer.AvatarFileName))
                                    {
                                        <img src="/images/avatars/@_cachedActiveRacer.AvatarFileName" 
                                             class="medium-racer-avatar" 
                                             alt="@_cachedActiveRacer.Name's Avatar" />
                                    }
                                    else
                                    {
                                        <div class="medium-racer-avatar-default">
                                            @(_cachedActiveRacer.Name.Substring(0, 1).ToUpper())
                                        </div>
                                    }
                                </div>
                                <div class="results-racer-info">
                                    <h3 class="results-racer-name">@_cachedActiveRacer.Name</h3>
                                </div>
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <div class="results-racer-display">
                            <div class="results-racer-avatar-container">
                                <div class="medium-racer-avatar-default">
                                    <i class="fas fa-user-astronaut"></i>
                                </div>
                            </div>
                            <div class="results-racer-info">
                                <h3 class="results-racer-name">Guest Racer</h3>
                            </div>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <EditForm EditContext="@editContext" OnValidSubmit="@(async () => await StartClick())">
                <button class="play-again-button" type="submit" tabindex="0" autofocus="autofocus">
                    <i class="fas fa-play"></i> Play Again
                </button>
                <input type="text" id="hidden" />
            </EditForm>

            <div class="race-stats">
                <div class="stat-card">
                    <div class="stat-label">Your Time</div>
                    <div class="stat-value">@FinishTime.ToString("F3")</div>
                </div>

                <div class="stat-card">
                    <div class="stat-label">Average</div>
                    <div class="stat-value">@prevAverage.ToString("F3")</div>
                </div>

                @if (improvedTime > 0) {
                    <div class="stat-card improvement">
                        <div class="stat-label">Improvement</div>
                        <div class="stat-value">+@improvedTime.ToString("F3")</div>
                    </div>
                }
            </div>

            <div class="leaderboard">
                <h2 class="leaderboard-title">Top 5 Results</h2>
                <div class="score-list">
                    @for (int i = 0; i < previousResults.Length; i++) {
                        string formattedTime = (previousResults[i] > 0) ? previousResults[i].ToString("F3") : "0";
                        <div class="score-item @(i == currentResultIndex ? "current-score" : "")">
                            <span class="rank">@(i + 1)</span>
                            <span class="time">@formattedTime</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    <p></p>
} else {
    @if (problem != null) {
        <p class="TC">            <TrackContainer 
                @ref="trackContainerInstance" 
                Track="@track" 
                Distance="@(track.Cars.Any() ? track.Cars.Max(c => c.Distance) : 0)"                                        
                ShowDebug="@ShowDebug" 
                IsMoving="@(track.Cars.Any(c => c.Top > 0))" />

            @* Results Popup Panel *@
            @if (ShowResultsPopup) {
                <div class="results-popup-overlay">
                    <div class="results-popup-panel">
                        <div class="results-popup-header">
                            <div class="results-trophy-icon">
                                @if (IsFirstPlace) {
                                    <i class="fas fa-trophy"></i>
                                } else {
                                    <i class="fas fa-medal"></i>
                                }
                            </div>
                            <h2 class="results-popup-title">
                                @if (IsFirstPlace) {
                                    <span class="victory-text">Great race! You won.</span>
                                } else {
                                    <span class="good-race-text">Good race.</span>
                                }
                            </h2>
                        </div>
                        
                        <div class="results-popup-content">
                            <div class="results-time-display">
                                <div class="time-label">Your Time</div>
                                <div class="time-value">@FinishTime.ToString("F3")s</div>
                            </div>
                            
                            @if (CarsBeaten > 0) {
                                <div class="results-achievement">
                                    <div class="achievement-icon">
                                        <i class="fas fa-star"></i>
                                    </div>
                                    <div class="achievement-text">
                                        You beat <strong>@CarsBeaten</strong> of the previous top 5 times!
                                    </div>
                                </div>
                            }
                            
                            @if (IsPersonalBest) {
                                <div class="personal-best-badge">
                                    <i class="fas fa-fire"></i>
                                    <span>Personal Best!</span>
                                </div>
                            }
                        </div>
                        
                        <div class="results-popup-position">
                            @if (IsFirstPlace) {
                                <div class="position-badge first-place">
                                    <span class="position-number">1st</span>
                                    <span class="position-label">Place</span>
                                </div>
                            } else if (currentResultIndex >= 0) {
                                <div class="position-badge">
                                    <span class="position-number">@GetOrdinalNumber(currentResultIndex + 1)</span>
                                    <span class="position-label">Place</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="stoplight-container">
                <div class="stoplight">
                    <div class="light red"></div>
                    <div class="light yellow"></div>
                    <div class="light green"></div>
                </div>
            </div>
            @if (Running && !CurrentRacerFinished) {
                <div class="problem-container delayed-show">
                    <div class="game-hud">
                        @* <div class="speed-meter">
                    <div class="speed-dial">
                        <span class="speed-value">@(Math.Round(track.Cars[0].Speed * 8))km/h</span>
                    </div>
                </div> *@

                        <div class="math-problem">
                            <div class="problem-bubble">
                                <h2 class="problem-text">@problem.Description</h2>
                            </div>
                        </div>

                        <div class="answer-box">
                            <input class="answer-input" type="tel" @ref="textInput" @bind="Answer" @bind:event="oninput"
                                   @bind:after="OnAfter" placeholder="Type your answer..." />
                        </div>
                        <button class="emergency-exit-button" @onclick="GoBack">
                            <i class="fas fa-exclamation-circle"></i> Emergency Exit
                        </button>
                    </div>
                </div>
            }

        </p>
        @if (!CurrentRacerFinished) {
            <div class="problem-container delayed-show">
                @* <h2 class="race-description"><b>@problem.Description </b></h2> *@                <div class="speed-indicator player-speed">
                    <div class="speed-label">YOUR SPEED</div>
                    <span class="speed-value">@(Math.Round(track.Cars[0].Speed * 7 * 1.09))kph</span>
                </div>
                @* <input class="form-control mb-2 race-input-box" type="tel" @ref="textInput" @bind="Answer" @bind:event="oninput"
                    @bind:after="OnAfter" /> *@
                <div class="ignoremouseclick" @onclick:preventDefault @onclick="OnAfterIgnore"></div>
            </div>
        }
        <p> </p>
    }
}
