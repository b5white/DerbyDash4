@page "/race/{ProblemClassString}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@implements IDisposable
@using DerbyDash.Components.Problems
@using DerbyDash.Components.Layout
@using Microsoft.AspNetCore.Components.Web

@if (!Started)
{
    <div class="race-start-container">
        <div class="race-title-box">
            <h1 class="race-title">@GetTitle(ProblemClassString)</h1>
            <p class="race-subtitle">Ready to race with numbers?</p>
        </div>

        <EditForm EditContext="@editContext" OnValidSubmit="StartClick">
            <input type="text" id="hidden" style="position:absolute; left:-9999px;" tabindex="0" />
            <button type="submit" tabindex="1" id="startButton" class="race-start-button" autofocus>
                <div class="button-content">
                    <i class="fas fa-flag-checkered"></i>
                    <span>Start Race</span>
                </div>
            </button>
        </EditForm>

        <div class="race-instructions">
            <p>Solve math problems to accelerate your car!</p>
        </div>
    </div>
}
else if (Finished)
{
    @if (ReceivedError)
    {
        <div class="error-container">
            <div class="error-message">
                <i class="fas fa-exclamation-circle"></i>
                <p>The system ran into a problem and couldn't calculate your results.</p>
            </div>
            <EditForm EditContext="@editContext" OnValidSubmit="StartClick">
                <button class="retry-button" type="submit" tabindex="0" autofocus="autofocus">
                    <i class="fas fa-redo"></i> Try again
                </button>
                <input type="text" id="hidden" />
            </EditForm>
        </div>
    }
    else
    {   <div class="results-box">

    </div>
        <div class="results-container">
            <div class="results-header">
                <h1 class="race-title">@GetTitle(ProblemClassString)</h1>
                <h2 class="encouraging-message">@encouragingWord</h2>
            </div>

            <!-- Move the play again button up, right after the header -->
            <EditForm EditContext="@editContext" OnValidSubmit="StartClick">
                <button class="play-again-button" type="submit" tabindex="0" autofocus="autofocus">
                    <i class="fas fa-play"></i> Play Again
                </button>
                <input type="text" id="hidden" />
            </EditForm>

            <div class="race-stats">
                <div class="stat-card">
                    <div class="stat-label">Your Time</div>
                    <div class="stat-value">@RaceTime.ToString("F3")</div>
                </div>

                <div class="stat-card">
                    <div class="stat-label">Average</div>
                    <div class="stat-value">@prevAverage.ToString("F3")</div>
                </div>

                @if (improvedTime > 0)
                {
                    <div class="stat-card improvement">
                        <div class="stat-label">Improvement</div>
                        <div class="stat-value">+@improvedTime.ToString("F3")</div>
                    </div>
                }
            </div>

            <div class="leaderboard">
                <h2 class="leaderboard-title">Top 5 Results</h2>
                <div class="score-list">
                    @for (int i = 0; i < previousResults.Length; i++)
                    {
                        string formattedTime = (previousResults[i] > 0) ? previousResults[i].ToString("F3") : "0";
                        <div class="score-item @(i == currentResultIndex ? "current-score" : "")">
                            <span class="rank">@(i + 1)</span>
                            <span class="time">@formattedTime</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    <p></p>
}
else
{
    @if (problem != null)
    {
        <p class="TC">
            <TrackContainer @ref="trackContainerInstance" Track="@track" Distance="@(track.Cars.Max(c => c.Distance))"
                IsMoving="@(track.Cars.Any(c => c.Top > 0))" />

        <div class="countdown-sequence">
            <div class="count three">3</div>
            <div class="count two">2</div>
            <div class="count one">1</div>
            <div class="count go">GO!</div>
        </div>
        @if (Running && !CurrentRacerFinished)
        {
            <div class="problem-container delayed-show">
                <div class="game-hud">
                    @* <div class="speed-meter">
                    <div class="speed-dial">
                        <span class="speed-value">@(Math.Round(track.Cars[0].Speed * 8))km/h</span>
                    </div>
                </div> *@

                    <div class="math-problem">
                        <div class="problem-bubble">
                            <h2 class="problem-text">@problem.Description</h2>
                        </div>
                    </div>

                    <div class="answer-box">
                        <input class="answer-input" type="tel" @ref="textInput" @bind="Answer" @bind:event="oninput"
                            @bind:after="OnAfter" placeholder="Type your answer..." />
                    </div>
                    <button class="emergency-exit-button" @onclick="GoBack">
                        <i class="fas fa-exclamation-circle"></i> Emergency Exit
                    </button>
                </div>
            </div>
        }

        </p>
        @if (!CurrentRacerFinished)
        {
            <div class="problem-container delayed-show">
                @* <h2 class="race-description"><b>@problem.Description </b></h2> *@
                <div class="speed-indicator">
                    <span class="speed-value">@(Math.Round(track.Cars[0].Speed * 7 * 1.09))kph</span>
                </div>
                @* <input class="form-control mb-2 race-input-box" type="tel" @ref="textInput" @bind="Answer" @bind:event="oninput"
                    @bind:after="OnAfter" /> *@
                <div class="ignoremouseclick" @onclick:preventDefault @onclick="OnAfterIgnore"></div>
            </div>
        }
        <p> </p>
    }
}
