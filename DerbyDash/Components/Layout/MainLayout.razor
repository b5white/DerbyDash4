@inherits MainLayoutBase
@using DerbyDash.Components.Layout
@using Microsoft.AspNetCore.Components.Routing
@using DerbyDash.Data
@inject NavigationManager NavManager
@inject GameStateService GameStateService

<BetaBanner />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="main">
        @if (!IsAuthPage && (!GameStateService.IsGameRunning || !IsOnRacePage))
        {
            <TopNavbar />
            <Breadcrumb />
        }
        <main>
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool IsAuthPage => NavManager.Uri.Contains("/Account/");
    private bool IsOnRacePage => NavManager.Uri.Contains("/race/");

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += LocationChanged;
        GameStateService.OnGameStateChanged += OnGameStateChanged;
        base.OnInitialized();
    }

    private async Task OnGameStateChanged(bool isGameRunning)
    {
        await InvokeAsync(StateHasChanged);
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Reset game state if navigating away from race pages
        if (!e.Location.Contains("/race/") && GameStateService.IsGameRunning)
        {
            // Use InvokeAsync to properly handle the async state changes
            InvokeAsync(async () => {
                await GameStateService.SetGameRunning(false);
                await GameStateService.SetCurrentRacePage("");
                StateHasChanged();
            });
        }
        else 
        {
            StateHasChanged();
        }
    }

    public new void Dispose()
    {
        NavManager.LocationChanged -= LocationChanged;
        GameStateService.OnGameStateChanged -= OnGameStateChanged;
        base.Dispose();
    }
}
