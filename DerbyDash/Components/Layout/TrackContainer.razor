@using DerbyDash.Components.Track
@using Microsoft.AspNetCore.Components.Web

<div class="road">
    @for (int i = 0; i < 5; i++)
    {
        <div class="lane-group @((Track.IsAnyCarAtTop && !Track.IsFinishLineVisible) ? $"animated speed-{Track.SpeedClass}" : "")">
            @for (int j = 0; j < 40; j++)
            {
                <div class="lane"></div>
            }
        </div>
    }

    <div class="track-container">
        <!-- Apply the same updated condition to start line animation -->
        <div class="start-line @(Track.StartLine.Visible ? "" : "hidden") @((Track.IsAnyCarAtTop && !Track.IsFinishLineVisible) ? $"animated speed-{Track.SpeedClass}" : "")"
            style="top: @Track.StartLine.TopStr;">
            <img src="/images/RaceTrack/@Track.StartLine.ImageUrl" alt="Start Line" />
        </div>
        <div class="finish-line" style="top: @Track.FinishLine.TopStr;">
            <img src="/images/RaceTrack/@Track.FinishLine.ImageUrl" alt="Finish Line" />
        </div>

        <div class="cars-container">
            @foreach (var car in Track.Cars)
            {
                <div class="car-dynamic" style="flex-basis: @car.FlexBasis; top: @car.TopStr;">
                    <img src="/images/RaceTrack/@car.ImageUrl" alt="Race car" />
                </div>
            }
        </div>
        @if (Track.ShowDebug) {
            <div class="debug-panel">
                @foreach (var car in Track.Cars) {
                    <div class="debug-info">
                        Speed: @car.Speed.ToString("F0")
                        Top: @car.Top.ToString("F0")
                        Distance: @car.Distance.ToString("F2")
                        Offset: @Track.LaneOffset.ToString("F0")
                    </div>
                }
                <div class="debug-info">
                    Start Top: @Track.StartLine.Top.ToString("F0")
                </div>
            </div>
        }
    </div>
</div>


