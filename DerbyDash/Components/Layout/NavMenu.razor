@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web

@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<div class="sidebar-header">
    <a class="navbar-brand" href="">
        <div class="logo-container">
            <img src="images/racehorse1.png" alt="Derby Dash Logo" class="logo-image" />
            <div class="logo-text">
                <span class="derby">Derby</span><span class="dash">Dash</span>
            </div>
        </div>
    </a>
    <input type="checkbox" title="Navigation menu" class="navbar-toggler" id="navbar-toggler" @onclick="ToggleNavMenu" />
</div>

<div @ref="navScrollableElement" class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="nav-icon fas fa-home"></i>
                <span class="nav-text">Home</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="RaceSetsMenu" Match="NavLinkMatch.All">
                <i class="nav-icon fas fa-flag-checkered"></i>
                <span class="nav-text">Races</span>
            </NavLink>
        </div>
        
        <div class="nav-item">
            <NavLink class="nav-link" href="aboutdemo" Match="NavLinkMatch.All">
                <i class="nav-icon fas fa-question-circle"></i>
                <span class="nav-text">About Demo</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="faq" Match="NavLinkMatch.All">
                <i class="nav-icon fas fa-question-circle"></i>
                <span class="nav-text">FAQ</span>
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-divider">
                    <span>Account</span>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Manage/RaceTeam" Match="NavLinkMatch.All">
                        <i class="nav-icon fas fa-users"></i>
                        <span class="nav-text">Race Team</span>
                    </NavLink>
                </div>

                <div class="nav-item profile-item">
                    <NavLink class="nav-link profile-link" href="Account/Manage" Match="NavLinkMatch.All">
                        <i class="nav-icon fas fa-user-circle"></i>
                        <span class="nav-text">Profile</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link pay-it-forward-link" href="PayItForward" Match="NavLinkMatch.All">
                        <i class="nav-icon fas fa-gift"></i>
                        <span class="nav-text">Pay it Forward</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link subscription-link" href="subscription" Match="NavLinkMatch.All">
                        <i class="nav-icon fas fa-star"></i>
                        <span class="nav-text">Subscription</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link about-link" href="about" Match="NavLinkMatch.Prefix">
                        <i class="nav-icon fas fa-info-circle"></i>
                        <span class="nav-text">About DerbyDash</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link logout-link" @onclick="HandleLogoutClick">
                        <i class="nav-icon fas fa-sign-out-alt"></i>
                        <span class="nav-text">Logout</span>
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-divider">
                    <span>Account</span>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Register" Match="NavLinkMatch.All">
                        <i class="nav-icon fas fa-user-plus"></i>
                        <span class="nav-text">Register</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Login" Match="NavLinkMatch.All">
                        <i class="nav-icon fas fa-sign-in-alt"></i>
                        <span class="nav-text">Login</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link about-link" href="about" Match="NavLinkMatch.Prefix">
                        <i class="nav-icon fas fa-info-circle"></i>
                        <span class="nav-text">About DerbyDash</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <div class="version-number">
        Version @AppInfo.Version
    </div>
</div>

@code {
    private ElementReference navScrollableElement; // Reference to the div

    // Method to toggle the CSS class via JavaScript
    private async Task ToggleNavMenu() {
        await JSRuntime.InvokeVoidAsync("toggleClass", navScrollableElement, "show-menu");
    }

    private void HandleLogoutClick() {
        // Force a page reload to ensure proper logout
        NavManager.NavigateTo("/Account/Logout", forceLoad: true);
    }

    // Assuming AppInfo is defined elsewhere or remove if not needed
    // public static class AppInfo { public static string Version = "1.0.0"; }

    // No Dispose method here - it's in NavMenu.razor.cs
}

