@using DerbyDash.Data
@using DerbyDash.Services
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
@implements IDisposable

<div class="top-navbar @(GetNavbarClasses())">
    <div class="container-fluid">
        <div class="page-info">
            <div class="page-title">
                <i class="@GetPageIcon()"></i>
                <h1>@GetPageTitle()</h1>
            </div>
            <div class="page-subtitle">
                @GetPageMotivation()
            </div>
        </div>
        <div class="top-navbar-content">
            <AuthorizeView>
                <Authorized>
                    
                    @if (Racers.Count == 0) {
                        <div class="no-racers-message">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>No racers available. <a href="Account/Manage/RaceTeam">Add a racer</a></span>
                        </div>
                    } else {
                        <div class="racer-selector">
                            <div class="racer-icon">
                                @if (UserAvatarFileName != null)
                                {
                                    <img src="/images/avatars/@UserAvatarFileName" class="racer-avatar-img" alt="User Avatar" />
                                }
                                else if (!string.IsNullOrEmpty(UserInitial))
                                {
                                    <div class="racer-avatar-default">@UserInitial</div>
                                }
                                else
                                {
                                    <i class="fas fa-user-astronaut"></i>
                                }
                            </div>
                            <div class="racer-dropdown-container">
                                <label for="currentRacer">
                                    <i class="fas fa-exchange-alt"></i> Select Your Racer
                                </label>
                                <div class="select-wrapper">
                                    <select id="currentRacer" class="racer-dropdown" value="@SelectedRacer.Id" @onchange="OnRacerChanged" @onchange:preventDefault title="Click to change your active racer">
                                        @foreach (var racer in Racers) {
                                            <option value="@racer.Id">@racer.Name (@racer.RaceCount races)</option>
                                        }
                                    </select>
                                    <div class="select-hint">
                                        <span class="race-stats">
                                            <span class="current-racer-races">Current: @CurrentRacerRaceCount races</span>
                                            <span class="team-races">Team: @TeamRaceCount total races</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </Authorized>
                <NotAuthorized>
                    <div class="login-prompt">
                        <span>Sign in to create your race team</span>
                        <a href="Account/Login" class="login-button">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

<style>
.user-avatar-navbar {
    display: flex;
    align-items: center;
    margin-right: 1.5rem;
}
.navbar-avatar-img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #ff9800;
    box-shadow: 0 2px 8px rgba(255,152,0,0.10);
    object-fit: cover;
    margin-right: 0.5rem;
}
.navbar-avatar-default {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff9800 0%, #ffb74d 100%);
    color: #fff;
    font-size: 1.6rem;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 0.5rem;
    box-shadow: 0 2px 8px rgba(255,152,0,0.10);
}

.race-stats {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: #666;
    margin-top: 4px;
}

.current-racer-races {
    color: #ff9800;
    font-weight: bold;
}

.team-races {
    color: #2980b9;
    font-weight: bold;
}
</style>

@code {
    // Expose avatar properties for use in markup
    private string? GetUserAvatarFileName() => UserAvatarFileName;
    private string? GetUserInitial() => UserInitial;
}

