@page "/Account/ExternalLogin"
@rendermode InteractiveWebAssembly
@attribute [AllowAnonymous]

<PageTitle>External Login - TurboFlash</PageTitle>

<div class="alert alert-info">
    <i class="fas fa-info-circle"></i> External login (OAuth) is not yet available in the client application. 
    This feature requires server-side OAuth configuration. Please use email/password login instead.
</div>
<div class="mt-3">
    <a href="/Account/Login" class="btn btn-primary">Go to Login</a>
</div>
