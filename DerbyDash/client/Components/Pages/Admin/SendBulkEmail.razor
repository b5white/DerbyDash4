@page "/admin/bulk-email"
@rendermode InteractiveWebAssembly
@attribute [Authorize]

<PageTitle>Send Bulk Email - TurboFlash Admin</PageTitle>

<div class="alert alert-warning">
    <h3><i class="fas fa-exclamation-triangle"></i> Admin Feature Not Available</h3>
    <p>
        Sending bulk emails is a server-only admin feature that requires server-side email services. 
        This feature is only available on the server application.
    </p>
    <p>
        Please access this feature through the server admin interface.
    </p>
</div>
<div class="mt-3">
    <a href="/" class="btn btn-primary">Return to Home</a>
</div>
