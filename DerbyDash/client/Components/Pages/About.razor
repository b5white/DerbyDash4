@page "/about"
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IDisposable
@inject NavigationManager NavManager
@inject IConfiguration Configuration
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@attribute [AllowAnonymous]

<PageTitle>About TurboFlash</PageTitle>

@* Load the About page CSS from the server *@
@if (!string.IsNullOrEmpty(serverUrl))
{
    <link rel="stylesheet" href="@($"{serverUrl}/css/About.css")" />
}

@if (isLoading)
{
    <div class="loading-container" style="text-align: center; padding: 2rem;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading About page...</p>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert" style="margin: 2rem;">
        @errorMessage
    </div>
}
else if (!string.IsNullOrEmpty(htmlContent))
{
    @((MarkupString)htmlContent)
}

@code {
    private bool isLoading = true;
    private string? htmlContent;
    private string? errorMessage;
    private string? serverUrl;

    protected override async Task OnInitializedAsync() {
        try {
            // Get server URL from configuration (ApiBaseUrl)
            serverUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5030";
            
            // Build the About page URL
            var aboutUrl = $"{serverUrl}/about";
            
            // Preserve query string if present
            var currentUri = NavManager.ToAbsoluteUri(NavManager.Uri);
            if (!string.IsNullOrEmpty(currentUri.Query)) {
                aboutUrl += currentUri.Query;
            }
            
            // Create a new HttpClient for fetching the page (without auth since About is public)
            using var httpClient = new HttpClient();
            httpClient.Timeout = TimeSpan.FromSeconds(10);
            
            // Fetch the HTML content
            var response = await httpClient.GetAsync(aboutUrl);
            
            if (response.IsSuccessStatusCode) {
                var html = await response.Content.ReadAsStringAsync();
                
                // Extract the body content (we want just the main content, not the full HTML document)
                // The server returns a Razor Page, so we need to extract the relevant content
                htmlContent = ExtractBodyContent(html);
                
                // If extraction failed or got too little content, try to get the whole body
                if (string.IsNullOrWhiteSpace(htmlContent) || htmlContent.Trim().Length < 500) {
                    // Fallback: extract entire body
                    htmlContent = ExtractEntireBody(html);
                }
                
                // If still no good content, use the raw HTML (last resort)
                if (string.IsNullOrWhiteSpace(htmlContent) || htmlContent.Trim().Length < 500) {
                    htmlContent = html;
                }
                
                // Fix relative URLs for static resources (images, etc.) to point to the server
                // But keep navigation links relative so they work within the Blazor client app
                htmlContent = FixStaticResourceUrls(htmlContent, serverUrl);
                
                // Set up link interceptors after content is ready
                StateHasChanged();
                await Task.Delay(100); // Small delay for DOM to update
                await InterceptLinkClicks();
            } else {
                errorMessage = $"Failed to load About page. Status: {response.StatusCode}";
            }
        } catch (Exception ex) {
            errorMessage = $"Error loading About page: {ex.Message}";
        } finally {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    private string ExtractBodyContent(string html) {
        // Try multiple patterns to find the about-container div
        var patterns = new[] {
            "<div class=\"about-container\">",
            "<div class='about-container'>",
            "class=\"about-container\"",
            "class='about-container'"
        };
        
        int startIndex = -1;
        string? startTag = null;
        
        foreach (var pattern in patterns) {
            var index = html.IndexOf(pattern, StringComparison.OrdinalIgnoreCase);
            if (index >= 0) {
                // Find the opening <div> tag
                var divStart = html.LastIndexOf("<div", index, StringComparison.OrdinalIgnoreCase);
                if (divStart >= 0) {
                    startIndex = divStart;
                    startTag = pattern;
                    break;
                }
            }
        }
        
        if (startIndex >= 0) {
            // Find the opening tag end
            var tagEnd = html.IndexOf(">", startIndex);
            if (tagEnd < 0) return ExtractEntireBody(html);
            
            // Find the matching closing div by counting nested divs
            var depth = 0;
            var endIndex = -1;
            
            // Start searching from after the opening tag
            for (int i = tagEnd + 1; i < html.Length - 6; i++) {
                var remaining = html.Length - i;
                
                // Check for opening div
                if (remaining >= 4 && html.Substring(i, 4).Equals("<div", StringComparison.OrdinalIgnoreCase)) {
                    // Make sure it's not a closing tag or self-closing
                    var nextChars = remaining >= 10 ? html.Substring(i, 10) : html.Substring(i);
                    if (!nextChars.StartsWith("</div", StringComparison.OrdinalIgnoreCase)) {
                        depth++;
                    }
                } 
                // Check for closing div
                else if (remaining >= 6 && html.Substring(i, 6).Equals("</div>", StringComparison.OrdinalIgnoreCase)) {
                    if (depth == 0) {
                        endIndex = i + 6;
                        break;
                    }
                    depth--;
                }
            }
            
            if (endIndex > startIndex) {
                var extracted = html.Substring(startIndex, endIndex - startIndex);
                // Verify we got substantial content
                if (extracted.Length > 500) {
                    return extracted;
                }
            }
        }
        
        // Fallback to entire body
        return ExtractEntireBody(html);
    }
    
    private string ExtractEntireBody(string html) {
        // Extract body content - try multiple patterns
        var bodyPatterns = new[] {
            ("<body", "</body>"),
            ("<main", "</main>"),
            ("<div", "</div>")
        };
        
        foreach (var (startTag, endTag) in bodyPatterns) {
            var bodyStart = html.IndexOf(startTag, StringComparison.OrdinalIgnoreCase);
            if (bodyStart >= 0) {
                var bodyTagEnd = html.IndexOf(">", bodyStart);
                if (bodyTagEnd >= 0) {
                    var bodyEnd = html.IndexOf(endTag, bodyTagEnd, StringComparison.OrdinalIgnoreCase);
                    if (bodyEnd > bodyTagEnd) {
                        var extracted = html.Substring(bodyTagEnd + 1, bodyEnd - bodyTagEnd - 1).Trim();
                        if (extracted.Length > 500) {
                            return extracted;
                        }
                    }
                }
            }
        }
        
        // If no body found, try to find the about-container directly
        var aboutContainerStart = html.IndexOf("about-container", StringComparison.OrdinalIgnoreCase);
        if (aboutContainerStart >= 0) {
            // Find the div tag containing this
            var divStart = html.LastIndexOf("<div", aboutContainerStart, StringComparison.OrdinalIgnoreCase);
            if (divStart >= 0) {
                var divTagEnd = html.IndexOf(">", divStart);
                if (divTagEnd >= 0) {
                    // Find matching closing div
                    var depth = 0;
                    var endIndex = -1;
                    for (int i = divTagEnd + 1; i < html.Length - 6; i++) {
                        if (html.Substring(i, 4).Equals("<div", StringComparison.OrdinalIgnoreCase)) {
                            depth++;
                        } else if (html.Substring(i, 6).Equals("</div>", StringComparison.OrdinalIgnoreCase)) {
                            if (depth == 0) {
                                endIndex = i + 6;
                                break;
                            }
                            depth--;
                        }
                    }
                    if (endIndex > divStart) {
                        return html.Substring(divStart, endIndex - divStart);
                    }
                }
            }
        }
        
        // Last resort: return the whole HTML
        return html;
    }
    
    private string FixStaticResourceUrls(string html, string serverUrl) {
        // Only fix src attributes (images, scripts) to point to the server
        // Leave href attributes relative so navigation works within the Blazor client app
        html = html.Replace("src=\"/", $"src=\"{serverUrl}/");
        html = html.Replace("src=\"~/", $"src=\"{serverUrl}/");
        
        // Also handle single quotes for src
        html = html.Replace("src='/", $"src='{serverUrl}/");
        html = html.Replace("src='~/", $"src='{serverUrl}/");
        
        // Note: We don't modify href attributes - they should remain relative
        // so they navigate within the Blazor client app (localhost:5173)
        
        return html;
    }
    
    
    private async Task InterceptLinkClicks() {
        // Use JavaScript to intercept clicks on links and use Blazor NavigationManager
        // This ensures navigation stays within the client app (localhost:5173)
        var dotNetRef = DotNetObjectReference.Create(this);
        
        try {
            await JSRuntime.InvokeVoidAsync("setupAboutPageLinks", dotNetRef);
        } catch (Exception ex) {
            Console.WriteLine($"Error setting up link interceptors: {ex.Message}");
        }
    }
    
    [JSInvokable]
    public void NavigateTo(string url) {
        NavManager.NavigateTo(url);
    }
    
    public void Dispose() {
        // Cleanup if needed
    }
}
