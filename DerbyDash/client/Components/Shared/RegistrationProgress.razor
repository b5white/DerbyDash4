@namespace DerbyDash.Components.Shared

<div class="registration-progress">
    <h3 class="progress-title">Registration Progress</h3>
    <div class="progress-steps">
        @foreach (var step in Steps) {
            <div class="progress-step @(step.IsActive ? "active" : "") @(step.IsCompleted ? "completed" : "")">
                <div class="step-number">
                    @if (step.IsCompleted) {
                        <i class="fas fa-check-circle"></i>
                    } else {
                        <span>@step.StepNumber</span>
                    }
                </div>
                <div class="step-content">
                    <div class="step-name">@step.Name</div>
                    <div class="step-description">@step.Description</div>
                </div>
                @if (step.IsCompleted && !string.IsNullOrEmpty(step.Url)) {
                    <a href="@step.Url" class="step-edit">
                        <i class="fas fa-edit"></i>
                    </a>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<RegistrationStep> Steps { get; set; } = new List<RegistrationStep>();

    [Parameter]
    public string CurrentStep { get; set; } = "";

    protected override void OnInitialized() {
        // Mark the current step as active
        var currentStep = Steps.FirstOrDefault(s => s.Id == CurrentStep);
        if (currentStep != null) {
            currentStep.IsActive = true;
        }

        // Mark all steps before the current one as completed
        bool foundCurrent = false;
        foreach (var step in Steps) {
            if (step.Id == CurrentStep) {
                foundCurrent = true;
            } else if (!foundCurrent) {
                step.IsCompleted = true;
            }
        }
    }

    public class RegistrationStep {
        public string Id { get; set; } = "";
        public int StepNumber { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Url { get; set; } = "";
        public bool IsActive { get; set; }
        public bool IsCompleted { get; set; }
    }
}